{
	"schemaVersion": 1,
	"id": "helio",
	"version": "${version}",
	"name": "Helio",
	"description": "Path tracing and DLSS for Minecraft on Vulkan.",
	"authors": ["bit"],
	"license": "MIT",
	"icon": "assets/helio/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.helio.Helio"],
		"modmenu": ["dev.helio.config.ModMenuEntry"]
	},
	"mixins": [
		{ "config": "helio.mixins.json", "environment": "client" },
		{ "config": "helio.sodium.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
