#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_scalar_block_layout : require

// After pathtrace.comp: fold each radiance cache cell's new samples into its running average, and free cells
// nothing has fed for a while. The entry layout and constants match pathtrace.comp's.

layout(local_size_x = 64) in;

struct CacheCell {
	uint check;  // second hash of the cell's key, 0 = free
	uint age;    // frames since a sample last came in
	uvec2 value; // running average (rgb) and the samples behind it, as halves
};
struct CacheSum {
	uvec3 sum;   // this frame's samples, fixed point (CACHE_FIXED)
	uint count;
};
// Cells first, then the sums, size * 16 bytes on (pathtrace.comp).
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer CacheCells { CacheCell c[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer CacheSums { CacheSum s[]; };

layout(push_constant) uniform Push {
	uvec2 cache;
	uint size;
} pc;

const float CACHE_FIXED = 4096.0;
const float MAX_SAMPLES = 128.0; // history: the average follows changes over about this many samples
const uint MAX_AGE = 64u;

void main() {
	uint i = gl_GlobalInvocationID.x;
	if (i >= pc.size) return;
	CacheCells cells = CacheCells(pc.cache);
	uint lo = pc.cache.x + pc.size * 16u;
	CacheSums sums = CacheSums(uvec2(lo, pc.cache.y + (lo < pc.cache.x ? 1u : 0u)));
	if (cells.c[i].check == 0u) return;
	uint count = sums.s[i].count;
	if (count == 0u) {
		if (++cells.c[i].age > MAX_AGE) {
			cells.c[i].check = 0u;
			cells.c[i].value = uvec2(0u);
		}
		return;
	}
	vec2 rg = unpackHalf2x16(cells.c[i].value.x), bn = unpackHalf2x16(cells.c[i].value.y);
	float n = bn.y, total = n + float(count);
	vec3 average = (vec3(rg, bn.x) * n + vec3(sums.s[i].sum) / CACHE_FIXED) / total;
	cells.c[i].value = uvec2(packHalf2x16(average.rg), packHalf2x16(vec2(average.b, min(total, MAX_SAMPLES))));
	sums.s[i].sum = uvec3(0u);
	sums.s[i].count = 0u;
	cells.c[i].age = 0u;
}
