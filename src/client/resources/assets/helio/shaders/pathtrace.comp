#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require
#ifdef HELIO_OMM
#extension GL_EXT_opacity_micromap : require
// Referencing the extension's ray flag makes the shader declare RayTracingOpacityMicromapKHR; without that
// capability ray queries ignore opacity micromaps (Micromaps.java) and run the alpha test everywhere.
const uint OMM_FLAGS = gl_RayFlagsForceOpacityMicromap2StateEXT & 0u;
#else
const uint OMM_FLAGS = 0u;
#endif

// M3 path tracer: primary ray per pixel, sun with a shadow ray, sky and block light, averaged over frames
// while nothing changes. Water, glass and ice reflect and let light through (water bends and absorbs it).
// Runs between vanilla's opaque and translucent passes and composites into the main colour where rays hit
// the scene.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform accelerationStructureEXT scene;
layout(binding = 1, rgba8) uniform image2D colorImg;
layout(binding = 2) uniform sampler2D blockAtlas;
// LabPBR maps laid out like the block atlas (PbrAtlas.java): _n normal XY, AO, height; _s smoothness, F0 / metal,
// porosity / SSS, emission. Specular all zero = the pack has no map.
layout(binding = 14) uniform sampler2D normalAtlas;
layout(binding = 15) uniform sampler2D specularAtlas;
// The physically based sky (Sky.java, sky.comp): transmittance (cos zenith, height), the sky's radiance by world
// direction, and the sky's irradiance onto faces along +-x, +-y, +-z (6x1).
layout(binding = 16) uniform sampler2D transmittanceLut;
layout(binding = 17) uniform sampler2D skyViewLut;
layout(binding = 18) uniform sampler2D ambientLut;
layout(binding = 19) uniform sampler3D cloudNoise; // Sky.java, cloud_noise.comp: r shapes, g detail; tiles
layout(binding = 3, rgba32f) uniform image2D accumImg; // premultiplied radiance + coverage, averaged over frames
layout(binding = 4, rgba32f) uniform image2D entityImg; // traced colour + NDC depth where an entity is hit (entity_composite.comp)
layout(binding = 5) uniform sampler2D depthTex; // vanilla's depth so far: sky and terrain past the RT distance
// DLSS Ray Reconstruction's inputs (RayReconstruction.java), written instead of compositing when Frame.denoise is set.
layout(binding = 6, rgba16f) uniform writeonly image2D rrColor;    // noisy linear radiance
layout(binding = 7, rgba8) uniform writeonly image2D rrDiffuse;    // diffuse albedo
layout(binding = 8, rgba8) uniform writeonly image2D rrSpecular;   // specular albedo
layout(binding = 9, rgba16f) uniform writeonly image2D rrNormals;  // world normal, roughness in w
layout(binding = 10, r32f) uniform writeonly image2D rrDepth;      // NDC depth (reversed-Z), like vanilla's
layout(binding = 11, rg16f) uniform writeonly image2D rrMotion;    // pixels from here to where it was last frame
layout(binding = 12, r16f) uniform writeonly image2D rrHitDistance; // of the reflection ray, for reflections' motion
layout(binding = 13, r32f) uniform writeonly image2D rrHitDepth;   // entity (+) or water / glass (-) depth, for rr_resolve.comp
layout(set = 1, binding = 0) uniform sampler2D entityTextures[256]; // this frame's entity textures (Entities.textures)

// Vertices in vanilla's BLOCK layout: position xyz, colour, UV0 uv, light levels (2 shorts); 7 floats for
// sections, 11 for entities: then the index into entityTextures and a motion offset (Entities.java).
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer Vertices { float v[]; };
// Light-emitting blocks around the camera (Lights.java): a table of the sections in range, each pointing at
// its run of lights.
struct Light { vec4 posEmission; vec4 colour; }; // block centre (held: hand) relative to the anchor + emission level; linear colour, w = 1 if held
layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer LightArray { Light l[]; };
const uint LIGHTS_NEAR = 0x80000000u; // on a cell's count: it or a neighbour has lights (Lights.NEAR)
layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer LightTable {
	ivec4 origin; // min section of the table relative to the anchor's; w = light count
	ivec4 dims;   // w = held lights, first in the array (at most MAX_HELD)
	uvec2 lights; // LightArray
	uvec2 pad;
	uvec2 cells[]; // first light, count (| LIGHTS_NEAR); x fastest, then y, then z
};
// What changes each frame but doesn't fit in the push constants.
layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer Frame {
	mat4 prevViewProj;  // last frame's viewProj (position relative to its camera -> clip)
	vec4 cameraDelta;   // this frame's camera position - last frame's; w = bounces (stochastic only)
	uint denoise;       // 1: trace at DLSS's render size and write its inputs; DLSS and rr_resolve.comp finish
	float lightFloor;   // least light anything gets, from vanilla's Brightness setting
	uint hybrid;        // 1: block light from vanilla's light levels, no shadow rays for it (HelioConfig.Lighting)
	uvec2 cache;        // CacheCells, then CacheSums; zero when off (only under Ray Reconstruction)
	ivec3 anchor;       // the scene anchor's world block position (a section corner)
	float caveFloor;    // share of lightFloor left where there's no sky light (HelioConfig.caveBrightness)
	float normalStrength; // how far normal maps tilt the surface, 1 = as the pack made them (HelioConfig)
	float exposure;     // radiance scale before the tonemap (PathTracer's auto exposure and the Exposure setting)
	uvec2 meter;        // Meter: this frame's log luminance, summed for the auto exposure
	float cloudTime;    // how far the clouds have drifted along +x, blocks (wraps every CLOUD_WEATHER_TILE)
	float cloudBottom;  // vanilla's cloud height
	float cloudCover;   // share of the sky clouds cover, 0 = vanilla's clouds are off
	float fadeEnd;      // blocks: vanilla's render distance, where its terrain has faded into the sky
	float nightFloor;   // share of lightFloor left outdoors at night (HelioConfig.nightBrightness)
	float wetness;      // how wet the open air leaves things: rain where the camera is, drying after (PathTracer)
	uint off;           // effects switched off, OFF_* bits: M7's cost breakdown (PathTracer.benchOff), 0 normally
	// Ray budget (M7 step 5; HelioConfig, set by the preset, tunable in the advanced settings):
	int fogSteps;         // volumetric fog steps, a shadow ray each (0: no shafts)
	int cloudSteps;       // steps through the cloud layer
	uint lightCandidates; // block lights weighed per shading point when stochastic (RR, reference); 8 otherwise
	float specularCutoff; // surfaces smoother than this (perceptual roughness) get a reflection ray
	uint cacheFeed;       // one 8x8 group in this many feeds the radiance cache each frame
	vec3 vanillaSky;      // vanilla's lightmap colour at full sky light, no block light (LightmapMixin)
	uvec4 meterCopy;      // PathTracer.METER: where the meter is copied for reading back
	uint vanillaJittered; // 1: vanilla's terrain was drawn with this frame's jitter (PathTracer.jitterLevelProjection)
};
// M7 bench: effects the cost breakdown can switch off one at a time (config/helio-bench.txt).
const uint OFF_SPECULAR = 1u, OFF_FOG = 2u, OFF_CLOUDS = 4u, OFF_BLOCK = 8u, OFF_BOUNCE = 16u, OFF_SUN = 32u, OFF_CAUSTICS = 64u,
	OFF_BLEND = 128u, // M8 step 10.0: the RT distance's edge as before (A/B)
	OFF_TRACED = 256u; // terrain everywhere shaded as past the RT distance (vanillaRadiance), to match it to the traced picture
uint off;
// Traced pixels' log2 luminance, in sixteenths, and how many (read back by PathTracer a few frames later).
// And the light's colour: red and blue over luminance of the light reaching surfaces (radiance over albedo), in
// 256ths, for Auto Warmth.
layout(buffer_reference, scalar, buffer_reference_align = 4) buffer Meter { int logSum; uint count; uint red; uint blue; };
// Radiance cache (M4 step 4, after NVIDIA's SHaRC): a hash table of world-space cells, each the light arriving
// at the faces in it (direct and bounced, without the face's own albedo). A bounce ray that lands in a cell
// takes its light from there instead of tracing on: every bounce after the first for the cost of one lookup.
// A few pixels a frame (feeding) follow longer paths and add what they find; radiance_cache.comp averages.
// Two arrays in one buffer (M7 step 4): what lookups read, 16 bytes a cell (a key's 8 probes share one 128-byte
// line), then the samples feeding pixels add, CACHE_SIZE * 16 bytes on. One 32-byte entry made lookups touch
// twice the memory, in a table four times the size of the L2 cache.
struct CacheCell {
	uint check;  // second hash of the cell's key, 0 = free
	uint age;    // frames since a sample last came in (radiance_cache.comp)
	uvec2 value; // running average (rgb) and the samples behind it, as halves
};
struct CacheSum {
	uvec3 sum;   // this frame's samples, fixed point (CACHE_FIXED)
	uint count;
};
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer CacheCells { CacheCell c[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer CacheSums { CacheSum s[]; };
// Per TLAS instance. kind: section layer (0 solid, 1 cutout, 2 translucent) or 3 = entities.
struct Instance { uvec2 vertices; uint triangles; uint kind; };
layout(buffer_reference, scalar, buffer_reference_align = 8) readonly buffer InstanceInfo { Instance i[]; };

const uint MASK_SOLID = 1u, MASK_CUTOUT = 2u, MASK_TRANSLUCENT = 4u, MASK_DYNAMIC = 8u, MASK_NOT_ONLY_WATER = 16u;
const uint MASK_OPAQUE_SCENE = MASK_SOLID | MASK_CUTOUT | MASK_DYNAMIC;
const uint PORTAL_FLAG = 0x20000u; // Entities.PORTAL, in an entity vertex's texture index: end portal / gateway faces
const uint KIND_CUTOUT = 1u, KIND_TRANSLUCENT = 2u, KIND_DYNAMIC = 3u;
const uint DEBUG_INSTANCES = 1u, DEBUG_ALBEDO = 2u, DEBUG_NORMALS = 3u, DEBUG_TRIANGLE_DENSITY = 4u, DEBUG_MATERIALS = 5u,
	DEBUG_PBR_NORMAL = 6u, DEBUG_PBR_SPECULAR = 7u;

// Sun and moon light above the atmosphere (Sky.SUN_TOP, MOON_TOP; sky.comp's tints): about 2.6 reaches the
// ground with the sun overhead. Nights read blue.
const float SUN_TOP = 2.9, MOON_TOP = 0.23;
const vec3 SUN_TINT = vec3(1.0, 0.98, 0.95), MOON = vec3(0.55, 0.65, 1.0);
const float SKY = 2.0;          // gain on the sky's light (radiance and irradiance), 1 = physical: next to sunlit snow the physical sky read dark navy
const float STAR = 40.0;        // the brightest stars' radiance at their centre (magnitudes fall steeply from it)
const float MILKY_WAY = 0.035;  // the Milky Way's glow at its brightest
const float MOON_GLINT = 2.5;   // the moon's face as seen, over its light: a pale grey disc, not a second sun
const float RAIN_LIGHT = 0.15;  // sun and moon light left in full rain (Sky.RAIN_LIGHT; 2% read as night)
const vec3 BLOCK_LIGHT = vec3(1.0, 0.68, 0.38) * 1.6;
const float LIGHT = 8.0;        // intensity of an emission-15 block light
const float EMISSIVE = 4.0;     // radiance of an emission-15 block's own surface, times its texture (M6 bloom keys off it)
const float PACK_GLOW = 0.5;    // emission of a resource pack's glowing texels on blocks that give no light (ores), as a share of EMISSIVE
uint lightCandidates;           // Frame.lightCandidates (4)
const uint CANDIDATES = 8u;     // lights considered per shading point (RIS) when not stochastic
const int MAX_HELD = 8;         // held lights (torches in hand...) sampled at most (Lights.MAX_HELD)
const float HELD_CLEAR = 0.5;   // a held light's shadow ray stops this far short of it: past the hand and item holding it
const float SUN_COS = 0.99994;  // 0.6 degree disc radius: soft-shadow penumbra
const float MOON_COS = 0.99996;
const float GLINT = 50.0;       // the sun and moon discs as seen (sky, reflections), over their direct light
// Vanilla's sun and moon as seen (half-width over distance): its quads are 30 and 20 wide at 100, the sun's
// bright core is the middle 8 of its texture's 32 pixels with a faint halo out to 22, the moon's face 20.
const float SUN_SIZE = 0.075, MOON_SIZE = 0.125;
const float WATER_IOR = 1.33, GLASS_IOR = 1.5;
const float WATER_OPACITY = 0.3;     // how much of water's texture shows on its surface; the rest is seen through
const float WATER_ABSORPTION = 0.15; // per block, as a power of the water's (linear) tint
const float WATER_SCATTER = 0.1;     // light the water itself sends back, over the sky and sun reaching it
const vec3 WATER_TINT = vec3(0.046, 0.184, 0.782); // vanilla's default 0x3F76E4: absorption when the camera starts underwater
const float SKY_FILL = 0.4;     // share of sky light added by sky level when stochastic (missing bounces)
const float MAX_SAMPLE = 12.0;
const float SKY_SAMPLE = 32.0;  // the same for the sky (its sun)
const float SKY_DISTANCE = 65504.0; // RR's hit distance for rays that escape (FP16 max)   // luminance cap on what RR gets: sun glints off water and metal flicker past it
const float FOLIAGE_TRANSMISSION = 0.5; // light leaves and grass let through, over what they reflect
const float SSS_TRANSMISSION = 1.0;     // the same at a pack's full subsurface value (LabPBR _s blue 255)
const float RT_BLEND = 0.25;            // share of the RT distance over which traced terrain fades into vanilla's, shaded alike (vanillaRadiance)
// Polished blocks (Scene.METAL_MARK, Scene.GEM_MARK): metals reflect in their own colour, slightly blurred,
// over a little diffuse; gems reflect faintly and sharply over their full colour.
const float METAL_ROUGHNESS = 0.2, METAL_DIFFUSE = 0.3, GEM_ROUGHNESS = 0.05, GEM_F0 = 0.08;
// LabPBR specular: surfaces smoother than this (perceptual roughness) get a reflection ray; rougher dielectrics
// stay diffuse. Metals always get one (they have no diffuse).
float specularCutoff;           // Frame.specularCutoff (0.6 by default)
// LabPBR's hardcoded metals (_s green 230-237): reflectance at normal incidence, linear.
const vec3 HARDCODED_F0[8] = vec3[](
	vec3(0.531, 0.512, 0.496), // iron
	vec3(1.000, 0.766, 0.336), // gold
	vec3(0.913, 0.922, 0.924), // aluminium
	vec3(0.550, 0.556, 0.554), // chrome
	vec3(0.955, 0.638, 0.538), // copper
	vec3(0.632, 0.626, 0.641), // lead
	vec3(0.672, 0.637, 0.585), // platinum
	vec3(0.972, 0.960, 0.915)  // silver
);
const int MAX_LAYERS = 6;
const uint CACHE_SIZE = 1u << 21;  // entries (PathTracer.CACHE_ENTRIES)
const uint CACHE_PROBES = 8u;      // slots a key may sit in, from its hash on
const float CACHE_FIXED = 4096.0;  // samples' fixed-point scale (atomic sums)
const float CACHE_MAX = 64.0;      // brightest sample kept, per channel
const int CACHE_PATH = 3;          // bounces a feeding pixel follows
uint cacheFeed;                   // Frame.cacheFeed: one 8x8 group in this many feeds the cache each frame (16)       // translucent surfaces a view ray passes before the next one counts as opaque

layout(push_constant) uniform Push {
	mat4 invViewProj;   // inverse(projection * viewRotation): NDC -> camera-relative world
	vec4 cameraInScene; // xyz camera position relative to the scene anchor, w = debug view (0 off, DEBUG_*)
	vec4 sunDir;        // xyz towards the sun, w = daylight (0 night .. 1 day)
	uvec2 instanceInfo;
	float rtDistance;   // blocks the scene surely covers around the camera, horizontally
	uint frameIndex;    // frames accumulated so far; 0 restarts
	vec2 jitter;        // sub-pixel offset of the primary ray (zero without accumulation)
	uint seed;          // changes every frame
	float stochastic;   // 1: sample area lights (needs accumulation or a denoiser), 0: their centre
	vec4 moonDir;       // xyz towards the moon, w = rain brightness (1 clear .. 0 raining)
	vec4 skyColor;      // x vanilla's moon phase (0 full .. 4 new .. 7), y its star brightness; w = 1 if the dimension has a sky
	vec4 fogColor;      // vanilla's fog (horizon) colour, sRGB; w = 1 if the camera is underwater
	mat4 viewProj;      // camera-relative world -> NDC, for depths that match vanilla's
	uvec2 lights;       // LightTable, zero without lights
	uvec2 frame;        // Frame
} pc;

bool hybrid; // Frame.hybrid
float normalStrength; // Frame.normalStrength

struct Hit {
	uint kind;
	vec3 albedo;    // linear
	vec3 normal;    // geometric, facing the ray: ray offsets, what's in front or behind
	vec3 shading;   // normal-mapped (LabPBR _n), on the ray's side: how light falls on the surface
	float ao;       // the texture's ambient occlusion (_n blue), on indirect light
	vec2 light;     // vanilla block / sky light level, 0..1
	float emission; // glow of the surface, 0..1 of EMISSIVE: the block's light level (sections encode it in vertex alpha),
	                // masked by the pack's emission map (LabPBR _s alpha) where it has one
	bool listed;    // a light block (in Lights.java's table): light sampling counts its light, bounces mustn't again
	bool portal;    // an end portal or gateway face (Entities.PORTAL): unlit, albedo * EMISSIVE * emission is its view
	vec3 tint;      // linear vertex colour (biome tint)
	float opacity;  // texture alpha: translucent surfaces let the rest through
	bool water;     // marked by vertex alpha (Scene.WATER_MARK)
	bool foliage;   // leaves and plants (Scene.FOLIAGE_MARK in the cutout layer): lets light through
	float transmission; // foliage: light let through, over what it reflects (the pack's subsurface value if any)
	bool glass;     // refracts: stained glass, ice and plain glass (translucent layer)
	bool metal, gem; // polished (Scene.METAL_MARK, GEM_MARK), or metal by the pack's specular map
	bool specular;   // gets a reflection ray (smooth enough, or metal)
	vec3 f0;         // reflectance at normal incidence
	float roughness; // perceptual (GGX alpha = roughness²)
	float diffuse;   // share of the non-reflected light scattered diffusely (metals: none)
	vec3 motion;    // entities: last frame's position relative to last frame's camera, minus now's; NaN if unknown
	vec4 pbrNormal, pbrSpecular; // raw LabPBR texels (entities: flat normal, no specular data)
};

uint strideOf(uint kind) {
	return kind == KIND_DYNAMIC ? 11u : 7u;
}

vec3 posAt(Vertices vb, uint vertex, uint stride) {
	return vec3(vb.v[vertex * stride], vb.v[vertex * stride + 1u], vb.v[vertex * stride + 2u]);
}

vec4 tintAt(Vertices vb, uint vertex, uint stride) {
	return unpackUnorm4x8(floatBitsToUint(vb.v[vertex * stride + 3u]));
}

vec2 uvAt(Vertices vb, uint vertex, uint stride) {
	return vec2(vb.v[vertex * stride + 4u], vb.v[vertex * stride + 5u]);
}

vec2 lightAt(Vertices vb, uint vertex, uint stride) {
	uint packed = floatBitsToUint(vb.v[vertex * stride + 6u]);
	return vec2(packed & 0xFFFFu, packed >> 16) / 240.0;
}

// The block atlas for sections; the entity's own texture for entities.
vec4 texel(Vertices vb, uint kind, uint vertex, vec2 uv) {
	if (kind != KIND_DYNAMIC) return textureLod(blockAtlas, uv, 0.0);
	return textureLod(entityTextures[nonuniformEXT(floatBitsToUint(vb.v[vertex * 11u + 7u]) & 0xFFFFu)], uv, 0.0);
}

// Quads are indexed 0 1 2, 2 3 0.
uvec3 triangleVertices(uint prim) {
	uint base = (prim >> 1) * 4u;
	return base + ((prim & 1u) == 0u ? uvec3(0u, 1u, 2u) : uvec3(2u, 3u, 0u));
}

// True while tracing what the camera sees directly: rays then pass through the player's own body in first
// person (entity vertices flagged with Entities.BODY), which only shadows and bounce light see.
bool cameraRay = false;
// Reflection rays pass through the body too: the camera sits inside its head, so a shiny floor would show it
// from inside.
bool reflectionRay = false;

// Cutout candidate: does the texel under the hit point pass vanilla's 0.5 alpha cutoff?
bool cutoutHit(rayQueryEXT rq) {
	Instance inst = InstanceInfo(pc.instanceInfo).i[rayQueryGetIntersectionInstanceIdEXT(rq, false)];
	Vertices vb = Vertices(inst.vertices);
	uint stride = strideOf(inst.kind);
	uvec3 t = triangleVertices(rayQueryGetIntersectionPrimitiveIndexEXT(rq, false));
	if ((cameraRay || reflectionRay) && inst.kind == KIND_DYNAMIC && (floatBitsToUint(vb.v[t.x * 11u + 7u]) & 0x10000u) != 0u) return false;
	if (inst.kind == KIND_DYNAMIC && (floatBitsToUint(vb.v[t.x * 11u + 7u]) & PORTAL_FLAG) != 0u) return true;
	// Reflections pass through water (Scene.WATER_MARK) in sections that also hold glass, ice or portals (water-only
	// sections are masked out): a water surface far off is a mirror of its own, not a wall.
	if (reflectionRay && inst.kind == KIND_TRANSLUCENT && round((1.0 - tintAt(vb, t.x, stride).a) * 255.0) == 1.0) return false;
	// Plain glass (Scene.GLASS_MARK): camera rays stop at its clear parts too, to refract there; light still passes them.
	if (cameraRay && round((1.0 - tintAt(vb, t.x, stride).a) * 255.0) == 2.0) return true;
	vec2 b = rayQueryGetIntersectionBarycentricsEXT(rq, false);
	vec2 uv = uvAt(vb, t.x, stride) * (1.0 - b.x - b.y) + uvAt(vb, t.y, stride) * b.x + uvAt(vb, t.z, stride) * b.y;
	// ponytail: entities use vanilla's 0.1 cutoff in some render types; 0.5 is close enough for shadows.
	// Translucent surfaces (water, stained glass, ice) count wherever they aren't fully clear.
	return texel(vb, inst.kind, t.x, uv).a >= (inst.kind == KIND_TRANSLUCENT ? 0.004 : 0.5);
}

// A macro, not a function: a ray query initialised inside a callee isn't guaranteed to be the caller's.
#define TRACE(rq, origin, dir, tMax, mask, flags) \
	rayQueryInitializeEXT(rq, scene, (flags) | OMM_FLAGS, mask, origin, 0.0, dir, tMax); \
	while (rayQueryProceedEXT(rq)) { if (cutoutHit(rq)) rayQueryConfirmIntersectionEXT(rq); }
#define TRACE_CAMERA(rq, origin, dir, tMax, mask) \
	cameraRay = true; TRACE(rq, origin, dir, tMax, mask, gl_RayFlagsNoneEXT) cameraRay = false;
#define HIT(rq) (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT)

float cloudTime, cloudBottom, cloudCover; // Frame (cloudTime: also the clock for waves and twinkling)
vec3 anchorWorld;                          // the scene anchor's world position (Frame.anchor)
float wetness;                             // Frame.wetness

// The water a view ray is in: per-block absorption, and the light the water itself sends back.
vec3 waterSigma, waterGlow;

// Water waves (M6 step 6): a height field of three octaves of the cloud noise's smooth Worley channel, sliced
// through time so it churns rather than slides; its slope tilts water's surface normal for reflection and
// refraction, and bends the sunlight that reaches under it (caustics). The surface itself stays flat.
const float WAVE_SLOPE = 0.15;    // how far the height field's gradient tilts the normal (0.25 read too choppy)
const float WATER_SHAFTS = 0.03;  // underwater: share of the light the water scatters towards the eye, per block

float waveHeight(vec2 w, float t) {
	// Half the frequencies first tried: wider waves and ripples.
	return textureLod(cloudNoise, vec3(w.x * 0.015, t * 0.03, w.y * 0.015), 0.0).g
		+ 0.45 * textureLod(cloudNoise, vec3(w.x * 0.045 + t * 0.01, t * 0.05, w.y * 0.045), 0.0).g
		+ 0.2 * textureLod(cloudNoise, vec3(w.x * 0.12, t * 0.09, w.y * 0.12 - t * 0.015), 0.0).g;
}

// The wave's normal (pointing up) at scene position pos on a water surface.
vec3 waveNormal(vec3 pos) {
	vec2 w = pos.xz + anchorWorld.xz;
	float t = cloudTime * 0.5, e = 0.15; // seconds of game time; finite-difference step, blocks
	float h0 = waveHeight(w, t);
	vec2 g = vec2(waveHeight(w + vec2(e, 0.0), t) - h0, waveHeight(w + vec2(0.0, e), t) - h0) / e * WAVE_SLOPE;
	return normalize(vec3(-g.x, 1.0, -g.y));
}

// Caustics: light along l crossing the water's surface at s, refracted by the waves, lands depth blocks below
// spread or bunched; its brightness there is the inverse of the area a patch of surface lands on.
float caustics(vec3 s, vec3 l, float depth) {
	if ((off & OFF_CAUSTICS) != 0u) return 1.0;
	if (depth < 0.2) return 1.0;
	const float e = 0.2;
	vec2 land[3];
	for (int k = 0; k < 3; k++) {
		vec3 p = s + vec3(k == 1 ? e : 0.0, 0.0, k == 2 ? e : 0.0);
		vec3 r = refract(-l, waveNormal(p), 1.0 / WATER_IOR);
		land[k] = p.xz + r.xz * (depth / max(-r.y, 0.05));
	}
	vec2 dx = land[1] - land[0], dz = land[2] - land[0];
	return clamp(e * e / max(abs(dx.x * dz.y - dx.y * dz.x), 1e-4), 0.3, 4.0);
}

// The colour a translucent surface a shadow ray crosses lets through: stained glass filters by its
// colour, as strongly as the texture is opaque. Water and ice nothing here; the nearest water surface crossed is
// kept in waterT / waterTint (its linear biome tint) for the absorption on the way up to it.
vec3 candidateTint(rayQueryEXT rq, inout float waterT, inout vec3 waterTint) {
	Instance inst = InstanceInfo(pc.instanceInfo).i[rayQueryGetIntersectionInstanceIdEXT(rq, false)];
	Vertices vb = Vertices(inst.vertices);
	uint stride = strideOf(inst.kind);
	uvec3 t = triangleVertices(rayQueryGetIntersectionPrimitiveIndexEXT(rq, false));
	vec2 b = rayQueryGetIntersectionBarycentricsEXT(rq, false);
	vec2 uv = uvAt(vb, t.x, stride) * (1.0 - b.x - b.y) + uvAt(vb, t.y, stride) * b.x + uvAt(vb, t.z, stride) * b.y;
	vec4 vertex = tintAt(vb, t.x, stride);
	float level = round((1.0 - vertex.a) * 255.0);
	if (level == 1.0) { // Scene.WATER_MARK
		float t = rayQueryGetIntersectionTEXT(rq, false);
		if (t < waterT) {
			waterT = t;
			waterTint = pow(vertex.rgb, vec3(2.2));
		}
		return vec3(1.0);
	}
	if (level == 2.0) return vec3(1.0); // Scene.ICE_MARK: clear (its blue texture tinted the lakebed under every tile)
	vec4 tex = texel(vb, inst.kind, t.x, uv);
	return pow(max(pow(tex.rgb * vertex.rgb, vec3(2.2)), vec3(0.001)), vec3(tex.a));
}

// Light that gets from origin along dir: none past anything opaque, else coloured by the stained glass
// it crosses (a second, translucent-only trace, where every surface counts), and absorbed by the water it rises
// through. ponytail: water is taken to fill the way up to its nearest surface; light shining down into water from
// above isn't absorbed.
vec3 shadowTransmittance(vec3 origin, vec3 dir, float tMax) {
	rayQueryEXT rq;
	TRACE(rq, origin, dir, tMax, MASK_OPAQUE_SCENE, gl_RayFlagsTerminateOnFirstHitEXT)
	if (HIT(rq)) return vec3(0.0);
	vec3 tint = vec3(1.0);
	rayQueryEXT tq;
	rayQueryInitializeEXT(tq, scene, gl_RayFlagsNoneEXT, MASK_TRANSLUCENT, origin, 0.0, dir, tMax);
	float waterT = tMax;
	vec3 waterTint = vec3(1.0);
	while (rayQueryProceedEXT(tq)) tint *= candidateTint(tq, waterT, waterTint);
	// As throughWater(): per block, the tint to the power WATER_ABSORPTION.
	if (dir.y > 0.0 && waterT < tMax) {
		tint *= pow(max(waterTint, vec3(0.01)), vec3(WATER_ABSORPTION * waterT));
		tint *= caustics(origin + dir * waterT, dir, waterT * dir.y);
	}
	return tint;
}

// End portals and gateways (M8): a window into deep space instead of vanilla's screen-space layers. Behind the
// face (n faces the viewer) lie layers of nebula and stars at growing depths, placed in world space, so they
// shift with true parallax as the camera moves; the last stars are at infinity (placed by direction alone).
// Everything drifts and twinkles slowly. The blocks' light is the same teal (Lights.colourOf).

vec3 portalHash(vec2 p) { // Hoskins' hash without sine, 3 outputs in [0, 1)
	vec3 q = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
	q += dot(q, q.yxz + 33.33);
	return fract((q.xxy + q.yzz) * q.zyx);
}

// One star in some cells of a grid over uv (cells per unit: density), of radius r (uv units), twinkling.
vec3 portalStars(vec2 uv, float density, float r, float seed, float time) {
	vec2 g = uv * density, cell = floor(g);
	vec3 h = portalHash(mod(cell, 4096.0) + seed * 97.0);
	if (h.z > 0.22) return vec3(0.0);
	vec2 d = (g - cell - 0.2 - 0.6 * h.xy) / density;
	float twinkle = 0.6 + 0.4 * sin(time * (1.3 + 3.0 * h.x) + 40.0 * h.y);
	vec3 colour = mix(vec3(0.45, 1.0, 0.85), vec3(0.8, 0.65, 1.0), h.y * h.y);
	return colour * (0.6 + 9.0 * h.x * h.x * h.x * h.x) * twinkle * exp(-dot(d, d) / (r * r));
}

vec3 portalView(vec3 world, vec3 dir, vec3 n) {
	float facing = max(-dot(dir, n), 0.08);
	vec3 ta = normalize(cross(n, abs(n.y) > 0.5 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0))), tb = cross(n, ta);
	// ponytail: world coordinates in floats; star placement gets coarse past ~100k blocks out.
	vec2 at = vec2(dot(world, ta), dot(world, tb)), slope = vec2(dot(dir, ta), dot(dir, tb)) / facing;
	float time = cloudTime * 0.5; // seconds of game time (as the waves)
	vec3 c = vec3(0.0006, 0.0015, 0.004); // the void
	for (int k = 0; k < 5; k++) {
		float depth = 0.5 * exp2(float(k) * 1.15); // 0.5 .. 12 blocks behind the face
		float angle = float(k) * 2.4;
		vec2 uv = at + slope * depth + time * 0.04 * vec2(cos(angle), sin(angle)); // the view ray there, drifting
		float fade = exp(-depth * 0.05);
		vec2 cloud = textureLod(cloudNoise, vec3(uv * (0.12 / (1.0 + 0.2 * depth)), 0.11 + 0.2 * float(k)), 0.0).rg;
		float wisp = smoothstep(0.55, 0.9, cloud.r) * (0.3 + cloud.g);
		c += mix(vec3(0.0, 0.3, 0.26), vec3(0.22, 0.02, 0.4), float(k) / 4.0) * wisp * 0.12 * fade;
		c += portalStars(uv, 1.4, 0.014 * (1.0 + 0.12 * depth), float(k), time) * fade;
	}
	c += portalStars(slope, 22.0, 0.006, 7.0, time) * 0.6; // at infinity
	return c;
}

Hit shade(rayQueryEXT rq, vec3 dir) {
	Hit h;
	Instance inst = InstanceInfo(pc.instanceInfo).i[rayQueryGetIntersectionInstanceIdEXT(rq, true)];
	h.kind = inst.kind;
	Vertices vb = Vertices(inst.vertices);
	uvec3 t = triangleVertices(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
	uint stride = strideOf(inst.kind);
	vec3 p0 = posAt(vb, t.x, stride);
	vec3 n = normalize(cross(posAt(vb, t.y, stride) - p0, posAt(vb, t.z, stride) - p0));
	h.normal = dot(n, dir) > 0.0 ? -n : n;
	vec2 b = rayQueryGetIntersectionBarycentricsEXT(rq, true);
	vec3 w = vec3(1.0 - b.x - b.y, b.x, b.y);
	vec2 uv = uvAt(vb, t.x, stride) * w.x + uvAt(vb, t.y, stride) * w.y + uvAt(vb, t.z, stride) * w.z;
	// Terrain tint is biome colour only (Helio compiles sections without vanilla's AO and face shading).
	vec3 tint = tintAt(vb, t.x, stride).rgb * w.x + tintAt(vb, t.y, stride).rgb * w.y + tintAt(vb, t.z, stride).rgb * w.z;
	vec4 tex = texel(vb, inst.kind, t.x, uv);
	h.albedo = pow(tex.rgb * tint, vec3(2.2));
	h.tint = pow(tint, vec3(2.2));
	h.opacity = tex.a;
	bool atlas = inst.kind != KIND_DYNAMIC;
	h.pbrNormal = atlas ? textureLod(normalAtlas, uv, 0.0) : vec4(0.5, 0.5, 1.0, 1.0);
	h.pbrSpecular = atlas ? textureLod(specularAtlas, uv, 0.0) : vec4(0.0);
	h.shading = h.normal;
	h.ao = h.pbrNormal.b;
	// Tangent frame from the triangle's UVs (sections have no vertex tangents). LabPBR maps are DirectX-style:
	// +Y points down the texture, along atlas V (checked against SPBR's height maps).
	vec2 du1 = uvAt(vb, t.y, stride) - uvAt(vb, t.x, stride), du2 = uvAt(vb, t.z, stride) - uvAt(vb, t.x, stride);
	float det = du1.x * du2.y - du2.x * du1.y;
	if (atlas && abs(det) > 1e-12) {
		vec3 e1 = posAt(vb, t.y, stride) - p0, e2 = posAt(vb, t.z, stride) - p0;
		vec3 tu = (e1 * du2.y - e2 * du1.y) / det, tv = (e2 * du1.x - e1 * du2.x) / det;
		tu = normalize(tu - h.normal * dot(tu, h.normal));
		tv = normalize(tv - h.normal * dot(tv, h.normal));
		vec2 xy = h.pbrNormal.rg * 2.0 - 1.0;
		float z = sqrt(max(1.0 - dot(xy, xy), 0.0));
		xy *= normalStrength;
		vec3 s = normalize(tu * xy.x + tv * xy.y + h.normal * z);
		// Never facing away from the ray: tilt it back to just past edge-on.
		float away = dot(s, dir);
		h.shading = away > -0.01 ? normalize(s - dir * (away + 0.01)) : s;
	}
	h.light = lightAt(vb, t.x, stride) * w.x + lightAt(vb, t.y, stride) * w.y + lightAt(vb, t.z, stride) * w.z;
	h.motion = vec3(0.0);
	if (inst.kind == KIND_DYNAMIC) {
		for (int i = 0; i < 3; i++) {
			uint vtx = t[i];
			h.motion += vec3(vb.v[vtx * 11u + 8u], vb.v[vtx * 11u + 9u], vb.v[vtx * 11u + 10u]) * w[i];
		}
	}
	float level = round((1.0 - tintAt(vb, t.x, stride).a) * 255.0);
	h.water = inst.kind == KIND_TRANSLUCENT && level == 1.0;
	h.foliage = inst.kind == KIND_CUTOUT && level == 1.0;
	h.transmission = 0.0;
	if (h.foliage) {
		// LabPBR _s blue: 0-64 porosity (M6 rain), 65-255 subsurface scattering.
		float b = round(h.pbrSpecular.b * 255.0);
		h.transmission = h.pbrSpecular == vec4(0.0) ? FOLIAGE_TRANSMISSION : max(b - 65.0, 0.0) / 190.0 * SSS_TRANSMISSION;
	}
	h.glass = inst.kind == KIND_TRANSLUCENT && !h.water;
	h.metal = inst.kind < KIND_TRANSLUCENT && level == 32.0;
	h.gem = inst.kind < KIND_TRANSLUCENT && level == 33.0;
	// Specular from the pack's LabPBR map where it has one (all zero: none), else Helio's polished marks.
	h.f0 = vec3(0.04);
	h.roughness = 1.0;
	h.diffuse = 1.0;
	h.specular = false;
	if (inst.kind < KIND_TRANSLUCENT && h.pbrSpecular != vec4(0.0)) {
		float g = round(h.pbrSpecular.g * 255.0);
		h.roughness = 1.0 - h.pbrSpecular.r;
		h.metal = g >= 230.0;
		h.gem = false;
		h.f0 = g < 230.0 ? vec3(g / 255.0) : g < 238.0 ? HARDCODED_F0[int(g) - 230] : h.albedo;
		h.diffuse = h.metal ? 0.0 : 1.0;
		h.specular = h.metal || h.roughness < specularCutoff;
	} else if (h.metal || h.gem) {
		h.f0 = h.metal ? h.albedo : vec3(GEM_F0);
		h.roughness = h.metal ? METAL_ROUGHNESS : GEM_ROUGHNESS;
		h.diffuse = h.metal ? METAL_DIFFUSE : 1.0;
		h.specular = true;
	}
	// Rain (M6 step 7): what the sky reaches (vanilla's sky light near full) gets wet, up-facing faces most (water
	// runs off walls). Wet surfaces darken as much as they're porous (LabPBR _s blue 0-64; 40% without pack
	// data, none for metal) and turn smooth and water-glossy; on flat ground puddles gather where a low-frequency
	// pattern dips, spreading as it rains longer: mirror-smooth, flat (no normal map), darker underneath.
	if (wetness > 0.0 && inst.kind < KIND_TRANSLUCENT && !h.foliage) {
		float exposed = smoothstep(0.86, 0.98, h.light.y) * wetness, up = clamp(h.normal.y, 0.0, 1.0);
		float b = round(h.pbrSpecular.b * 255.0);
		float porosity = h.metal ? 0.0 : h.pbrSpecular != vec4(0.0) && b < 65.0 ? b / 64.0 : 0.4;
		float wet = exposed * mix(0.35, 1.0, up);
		h.albedo *= mix(1.0, 0.55, wet * porosity);
		h.roughness = mix(h.roughness, 0.12, wet * mix(0.6, 1.0, up) * (1.0 - 0.5 * porosity));
		h.f0 = max(h.f0, vec3(0.02 * wet));
		if (up > 0.9 && exposed > 0.0) {
			vec3 world = rayQueryGetWorldRayOriginEXT(rq) + rayQueryGetWorldRayDirectionEXT(rq) * rayQueryGetIntersectionTEXT(rq, true) + anchorWorld;
			float pattern = textureLod(cloudNoise, vec3(world.x / 40.0, 0.3, world.z / 40.0), 0.0).r * 0.7
				+ textureLod(cloudNoise, vec3(world.x / 9.0, 0.6, world.z / 9.0), 0.0).g * 0.3;
			float edge = 1.0 - 0.5 * exposed, puddle = smoothstep(edge, edge + 0.05, pattern);
			h.roughness = mix(h.roughness, 0.02, puddle);
			h.shading = normalize(mix(h.shading, h.normal, puddle));
			h.albedo *= mix(1.0, 0.7, puddle);
		}
		h.specular = h.metal || h.roughness < specularCutoff;
	}
	h.emission = inst.kind == KIND_DYNAMIC || h.water || h.foliage || h.glass || level > 15.0 ? 0.0 : level / 15.0;
	h.listed = h.emission > 0.0;
	// LabPBR emission (0-254, 255 = none): which texels of a light block glow (a torch's flame, not its stick);
	// on other blocks (glowing ores) a glow of their own that lights the surroundings through bounces.
	if (inst.kind < KIND_TRANSLUCENT && h.pbrSpecular != vec4(0.0)) {
		float a = round(h.pbrSpecular.a * 255.0), texel = a < 255.0 ? a / 254.0 : 0.0;
		h.emission = h.listed ? h.emission * texel : PACK_GLOW * texel;
	}
	h.portal = inst.kind == KIND_DYNAMIC && (floatBitsToUint(vb.v[t.x * 11u + 7u]) & PORTAL_FLAG) != 0u;
	if (h.portal) {
		vec3 world = rayQueryGetWorldRayOriginEXT(rq) + dir * rayQueryGetIntersectionTEXT(rq, true) + anchorWorld;
		vec3 view = portalView(world, dir, h.normal);
		// Its view as albedo (in 0..1, for RR's guide) times a glow; light sampling already counts its light.
		h.emission = max(1.0, max(view.r, max(view.g, view.b)) / EMISSIVE);
		h.albedo = view / (EMISSIVE * h.emission);
		h.listed = true;
		// A faint glossy sheen on the window, like glass.
		h.f0 = vec3(0.03);
		h.roughness = 0.05;
		h.diffuse = 1.0;
		h.specular = true;
		h.metal = h.gem = false;
	}
	return h;
}

uint pcg(uint v) {
	uint state = v * 747796405u + 2891336453u;
	uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
	return (word >> 22u) ^ word;
}

vec2 random2(uvec2 p) {
	uint a = pcg(p.x + pcg(p.y + pcg(pc.seed)));
	return vec2(a & 0xFFFFu, pcg(a) & 0xFFFFu) / 65536.0;
}

// Per-pixel random stream. Without accumulation it doesn't change between frames: still grain, no flicker.
uint rng;
float rand() {
	rng = pcg(rng);
	return float(rng >> 8) / 16777216.0;
}

float luminance(vec3 c) {
	return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// Inverse-square from the block centre, windowed to zero at 15 blocks (vanilla light's reach, and the
// light table only covers neighbouring sections).
vec3 lightContribution(Light light, vec3 pos, vec3 n) {
	vec3 toLight = light.posEmission.xyz - pos;
	float d2 = dot(toLight, toLight), x = min(d2 / 225.0, 1.0), window = (1.0 - x * x) * (1.0 - x * x);
	return light.colour.rgb * (LIGHT * light.posEmission.w / 15.0) * max(dot(n, toLight) * inversesqrt(d2), 0.0)
		* window / (d2 + 0.25);
}

// Where a ray from o enters the unit box at c (0 if o is inside).
float boxEntry(vec3 o, vec3 dir, vec3 c) {
	vec3 inv = 1.0 / dir, t0 = (c - 0.5 - o) * inv, t1 = (c + 0.5 - o) * inv;
	vec3 tmin = min(t0, t1);
	return max(max(max(tmin.x, tmin.y), tmin.z), 0.0);
}

// Uniform direction within a cone of half-angle acos(cosMax) around d.
vec3 sampleCone(vec3 d, float cosMax, vec2 u) {
	float c = mix(1.0, cosMax, u.x), s = sqrt(1.0 - c * c), phi = 6.2831853 * u.y;
	vec3 t = normalize(cross(abs(d.y) < 0.99 ? vec3(0, 1, 0) : vec3(1, 0, 0), d));
	return normalize(t * (cos(phi) * s) + cross(d, t) * (sin(phi) * s) + d * c);
}

vec3 srgbToLinear(vec3 c) {
	return pow(c, vec3(2.2));
}

// Through the atmosphere from the viewer (sky.comp's VIEW_HEIGHT) towards cos zenith y: reddens towards the
// horizon, nothing past it (the planet's in the way). As sky.comp's transmittance LUT.
vec3 atmosphereTransmittance(float y) {
	float h = 0.2 / 100.0; // VIEW_HEIGHT over the atmosphere's thickness
	return textureLod(transmittanceLut, vec2(0.5 + 0.5 * sign(y) * sqrt(abs(y)), sqrt(h)), 0.0).rgb;
}

// Sunlight and moonlight reaching the ground from cos zenith y; rain dims them (and the sky, through Sky.java).
// Share of the moon's face lit: 1 full .. 0 new (vanilla's phase). Its light and the sky's glow follow it.
float moonLit() {
	return abs(floor(pc.skyColor.x + 0.5) - 4.0) * 0.25;
}

float rainDim() {
	return mix(RAIN_LIGHT, 1.0, pc.moonDir.w);
}

vec3 sunRadiance(float y) {
	return SUN_TOP * SUN_TINT * atmosphereTransmittance(y) * rainDim();
}

vec3 moonRadiance(float y) {
	return MOON_TOP * MOON * atmosphereTransmittance(y) * rainDim() * (0.15 + 0.85 * moonLit());
}

// Rain greys the sky.
vec3 overcast(vec3 c) {
	return mix(vec3(dot(c, vec3(0.2126, 0.7152, 0.0722))), c, pc.moonDir.w);
}

// Light from the sky dome onto a surface facing n, over pi (the radiance a white diffuse surface sends back):
// the ambient cube, blended by n's squared components.
vec3 skyIrradiance(vec3 n) {
	if (pc.skyColor.w == 0.0) return srgbToLinear(pc.fogColor.rgb) * 0.15; // Nether, End: no sky
	vec3 n2 = n * n;
	vec3 e = n2.x * texelFetch(ambientLut, ivec2(n.x > 0.0 ? 0 : 1, 0), 0).rgb + n2.y * texelFetch(ambientLut, ivec2(n.y > 0.0 ? 2 : 3, 0), 0).rgb
		+ n2.z * texelFetch(ambientLut, ivec2(n.z > 0.0 ? 4 : 5, 0), 0).rgb;
	return overcast(e) * (SKY / 3.14159265);
}

// Volumetric clouds (M6 step 4): a layer from vanilla's cloud height up CLOUD_THICKNESS blocks, shaped by the
// noise volume (cloud_noise.comp: Perlin-Worley shapes, Worley detail on their edges, a low-frequency weather
// pattern for where they gather), drifting with the wind while their edges churn. Cumulus-like: flat bases,
// towers narrowing upward, wispy undersides and billowing tops. Lit by the sun or moon through a march towards
// it (Beer's law with the powder darkening on edges facing it, a forward and a back lobe, two softer octaves for
// light scattered more than once) and the sky's light, dimmer towards the base.
const float CLOUD_THICKNESS = 250.0;
const float CLOUD_EXTINCTION = 0.05;       // per block, at full density
const float CLOUD_FAR = 6000.0;            // blocks: past this the layer isn't marched
// Few steps, jittered per pixel and frame: RR smooths what one frame's march leaves noisy (48 steps and 4
// light steps cost 5 ms at 1440p Balanced).
int cloudSteps;                            // Frame.cloudSteps (24)
const int CLOUD_LIGHT_STEPS = 4;
const float CLOUD_LIGHT_STEP = 12.0;       // the first; each next one twice as long (12, 24, 48, 96 blocks)
const float CLOUD_DETAIL_FAR = 2000.0;     // blocks: past this the edge detail is too small to see
// Noise scales, blocks per tile: each divides the next, so the wind's wrap (Frame.cloudTime, every weather tile)
// is seamless for every drift below.
const float CLOUD_DETAIL_TILE = 250.0, CLOUD_SHAPE_TILE = 1500.0, CLOUD_WEATHER_TILE = 12000.0;

float cloudDensity(vec3 w, bool detail) {
	float h = (w.y - cloudBottom) / CLOUD_THICKNESS;
	if (h <= 0.0 || h >= 1.0) return 0.0;
	float weather = textureLod(cloudNoise, vec3(w.x + cloudTime, 0.0, w.z) / CLOUD_WEATHER_TILE, 0.0).r;
	float cover = clamp(cloudCover + (weather - 0.5) * 0.6, 0.0, 1.0) * mix(1.0, 0.45, h); // towers narrow upward
	float shape = textureLod(cloudNoise, (w + vec3(cloudTime, 0.0, cloudTime * 0.25)) / CLOUD_SHAPE_TILE, 0.0).r;
	float profile = smoothstep(0.0, 0.05, h) * smoothstep(1.0, 0.8, h); // a flat base; tops fade before the layer ends
	float d = clamp((shape * profile - (1.0 - cover)) / max(cover, 0.05), 0.0, 1.0);
	// Past full cover (rain): an unbroken grey layer, the shapes still billowing through it.
	d = max(d, clamp((cloudCover - 1.0) / 0.15, 0.0, 1.0) * 0.6 * profile);
	if (detail && d > 0.0) {
		// The detail churns as it drifts; wispy (inverted) at the base, billowing higher up; it eats the thin edges.
		float n = textureLod(cloudNoise, (w + vec3(cloudTime * 1.5, cloudTime * 0.25, cloudTime * 0.5)) / CLOUD_DETAIL_TILE, 0.0).g;
		n = mix(1.0 - n, n, clamp(h * 6.0, 0.0, 1.0)) * 0.35;
		d = clamp((d - n) / (1.0 - n), 0.0, 1.0);
	}
	return d;
}

// Sun or moon light that gets through the clouds to scene position pos: two density samples through the layer.
float cloudShadow(vec3 pos, vec3 l) {
	if (cloudCover <= 0.0 || pc.skyColor.w == 0.0 || l.y <= 0.02) return 1.0;
	vec3 w = pos + anchorWorld;
	float sum = 0.0;
	for (int k = 0; k < 2; k++) {
		float t = (cloudBottom + CLOUD_THICKNESS * (0.3 + 0.35 * float(k)) - w.y) / l.y;
		if (t > 0.0) sum += cloudDensity(w + l * t, false);
	}
	return exp(-sum * 0.5 * CLOUD_EXTINCTION * CLOUD_THICKNESS / l.y);
}

float henyeyGreenstein(float c, float g) {
	return (1.0 - g * g) / (12.5663706 * pow(1.0 + g * g - 2.0 * g * c, 1.5));
}

// What the clouds add along a ray from scene position origin, up to tMax: radiance, and the transmittance that
// scales what's behind them.
vec4 clouds(vec3 origin, vec3 dir, float tMax) {
	if (cloudCover <= 0.0 || pc.skyColor.w == 0.0 || (off & OFF_CLOUDS) != 0u) return vec4(0.0, 0.0, 0.0, 1.0);
	vec3 o = origin + anchorWorld;
	float top = cloudBottom + CLOUD_THICKNESS, t0, t1;
	if (abs(dir.y) < 1e-4) {
		if (o.y <= cloudBottom || o.y >= top) return vec4(0.0, 0.0, 0.0, 1.0);
		t0 = 0.0;
		t1 = CLOUD_FAR;
	} else {
		float a = (cloudBottom - o.y) / dir.y, b = (top - o.y) / dir.y;
		t0 = max(min(a, b), 0.0);
		t1 = max(a, b);
	}
	t1 = min(min(t1, tMax), CLOUD_FAR);
	if (t1 <= t0) return vec4(0.0, 0.0, 0.0, 1.0);
	bool day = pc.sunDir.y > 0.0;
	vec3 l = day ? pc.sunDir.xyz : pc.moonDir.xyz;
	vec3 light = l.y > 0.0 ? (day ? sunRadiance(l.y) : moonRadiance(l.y)) : vec3(0.0);
	vec3 ambient = skyIrradiance(vec3(0.0, 1.0, 0.0));
	float c = dot(dir, l);
	float phase[3];
	for (int o = 0; o < 3; o++) { // softer for each octave
		float g = pow(0.5, float(o));
		phase[o] = mix(henyeyGreenstein(c, 0.7 * g), henyeyGreenstein(c, -0.2 * g), 0.4);
	}
	float powderShare = 0.6 * (0.5 - 0.5 * c); // none looking towards the light: its edges glow there
	float dt = (t1 - t0) / float(cloudSteps), t = t0 + dt * rand();
	vec3 radiance = vec3(0.0);
	float transmittance = 1.0;
	for (int i = 0; i < cloudSteps && transmittance > 0.02; i++, t += dt) {
		vec3 p = o + dir * t;
		float d = cloudDensity(p, t < CLOUD_DETAIL_FAR);
		if (d <= 0.0) continue;
		float depth = 0.0, along = 0.0; // towards the light
		for (int k = 0; k < CLOUD_LIGHT_STEPS; k++) {
			float len = CLOUD_LIGHT_STEP * float(1 << k);
			depth += cloudDensity(p + l * (along + len * 0.5), false) * len;
			along += len;
		}
		depth *= CLOUD_EXTINCTION;
		float h = (p.y - cloudBottom) / CLOUD_THICKNESS;
		vec3 direct = vec3(0.0);
		for (int o = 0; o < 3; o++) direct += pow(0.5, float(o)) * exp(-depth * pow(0.4, float(o))) * phase[o];
		direct *= mix(1.0, 2.0 * (1.0 - exp(-2.0 * depth)), powderShare);
		vec3 scattered = light * direct + ambient * mix(0.35, 1.0, h);
		float step = exp(-d * CLOUD_EXTINCTION * dt);
		radiance += transmittance * scattered * (1.0 - step);
		transmittance *= step;
	}
	// Far clouds fade into the sky behind them (aerial perspective, roughly).
	float fade = exp(-t0 / (CLOUD_FAR * 0.5));
	return vec4(radiance * fade, mix(1.0, transmittance, fade));
}

// Volumetric fog (M6 step 5): a thin haze, densest at sea level and thinning upwards, thicker in rain, lit by
// the sun or moon where it reaches (a shadow ray per step: shafts through leaves, cave mouths and cloud gaps)
// and by the sky as much as the ray's end sees it. fogSteps jittered steps over the first FOG_FAR blocks, longer
// with distance (boundaries at FOG_FAR (i / fogSteps)^2: shafts near the eye are the ones that show); RR smooths
// what one frame leaves noisy. Not underwater, and not in the Nether or End (no sun to make shafts).
const float FOG_DENSITY = 0.0012;  // extinction per block at sea level on a clear day (0.0025 greyed the sky)
const float FOG_HEIGHT = 80.0;     // blocks over which it thins by e
const float FOG_FAR = 160.0;
const float FOG_RAIN = 15.0;       // density in full rain, over a clear day's: about 170 blocks' visibility at sea level
const float FOG_TAIL = 1200.0;     // blocks: rain's fog past FOG_FAR, integrated in one go (unshadowed)
int fogSteps;                      // Frame.fogSteps, each a shadow ray: 6 cost 1.9 ms, 4 about 1 ms (M7 step 3: 2 by default)
float fogSkyLight = 1.0; // vanilla's sky light where the primary ray ended (1 for the sky): the haze's sky fill

// Underwater, the haze is the water's own: light shafts from the surface (through its waves: caustics) over the
// first 48 blocks, dimmed by the water between them and the eye like everything else (throughWater). Its
// absorption and glow themselves are throughWater's.
vec4 waterShafts(vec3 origin, vec3 dir, float tMax) {
	bool day = pc.sunDir.y > 0.0;
	vec3 l = day ? pc.sunDir.xyz : pc.moonDir.xyz;
	if (l.y <= 0.0) return vec4(0.0, 0.0, 0.0, 1.0);
	vec3 light = (day ? sunRadiance(l.y) : moonRadiance(l.y)) * henyeyGreenstein(dot(dir, l), 0.8);
	float t1 = min(tMax, 48.0), dt = t1 / float(max(fogSteps, 1)), t = dt * rand();
	vec3 radiance = vec3(0.0);
	for (int i = 0; i < fogSteps; i++, t += dt) {
		vec3 x = origin + dir * t;
		radiance += shadowTransmittance(x, l, 512.0) * light * WATER_SHAFTS * dt * exp(-waterSigma * t);
	}
	return vec4(radiance, 1.0);
}

vec4 fog(vec3 origin, vec3 dir, float tMax) {
	if (pc.skyColor.w == 0.0 || (off & OFF_FOG) != 0u) return vec4(0.0, 0.0, 0.0, 1.0);
	if (pc.fogColor.w != 0.0) return waterShafts(origin, dir, tMax);
	float t1 = min(tMax, FOG_FAR), jitter = rand();
	bool day = pc.sunDir.y > 0.0;
	vec3 l = day ? pc.sunDir.xyz : pc.moonDir.xyz;
	vec3 light = l.y > 0.0 ? (day ? sunRadiance(l.y) : moonRadiance(l.y)) : vec3(0.0);
	vec3 ambient = skyIrradiance(vec3(0.0, 1.0, 0.0)) * fogSkyLight * fogSkyLight;
	float phase = mix(henyeyGreenstein(dot(dir, l), 0.6), 0.0796, 0.3);
	float density = FOG_DENSITY * mix(FOG_RAIN, 1.0, pc.moonDir.w);
	vec3 radiance = vec3(0.0);
	float transmittance = 1.0;
	for (int i = 0; i < fogSteps; i++) {
		float a = float(i) / float(fogSteps), b = float(i + 1) / float(fogSteps);
		float t0 = t1 * a * a, dt = t1 * b * b - t0;
		vec3 x = origin + dir * (t0 + dt * jitter);
		float sigma = density * exp(-max(x.y + anchorWorld.y - 63.0, 0.0) / FOG_HEIGHT);
		vec3 inscatter = ambient;
		if (l.y > 0.0) {
			rayQueryEXT rq;
			TRACE(rq, x, l, 512.0, MASK_OPAQUE_SCENE, gl_RayFlagsTerminateOnFirstHitEXT)
			if (!HIT(rq)) inscatter += light * phase * cloudShadow(x, l);
		}
		float step = exp(-sigma * dt);
		radiance += transmittance * inscatter * (1.0 - step);
		transmittance *= step;
	}
	// Past FOG_FAR, rain's extra fog (not a clear day's: the sky has that haze already) in closed form: optical
	// depth through the height falloff, lit by the sky and unshadowed sun or moon. It greys the horizon and hides
	// far terrain.
	float extra = density - FOG_DENSITY;
	if (tMax > FOG_FAR && extra > 0.0) {
		float len = min(tMax, FOG_TAIL) - FOG_FAR, h0 = max(origin.y + dir.y * FOG_FAR + anchorWorld.y - 63.0, 0.0);
		float h1 = max(h0 + dir.y * len, 0.0);
		float depth = abs(dir.y) < 1e-3 ? extra * exp(-h0 / FOG_HEIGHT) * len
			: extra * FOG_HEIGHT / dir.y * (exp(-h0 / FOG_HEIGHT) - exp(-h1 / FOG_HEIGHT));
		float step = exp(-max(depth, 0.0));
		radiance += transmittance * (ambient + light * phase) * (1.0 - step);
		transmittance *= step;
	}
	return vec4(radiance, transmittance);
}

// Whether a block light could reach pos: a held light within its 15-block window (vanilla's levels don't know of
// them), or with blocks too, a light in one of the 27 sections around pos's (Lights.NEAR on its cell; the window
// is shorter than a section).
bool lightsNear(vec3 pos, bool blocks) {
	if (pc.lights == uvec2(0)) return false;
	LightTable table = LightTable(pc.lights);
	ivec3 c = ivec3(floor(pos / 16.0)) - table.origin.xyz;
	if (blocks && all(greaterThanEqual(c, ivec3(0))) && all(lessThan(c, table.dims.xyz))
		&& (table.cells[(c.z * table.dims.y + c.y) * table.dims.x + c.x].y & LIGHTS_NEAR) != 0u) return true;
	LightArray lights = LightArray(table.lights);
	for (int j = 0; j < table.dims.w; j++) {
		vec3 d = lights.l[j].posEmission.xyz - pos;
		if (dot(d, d) < 225.0) return true;
	}
	return false;
}

// Hybrid lighting: held lights as they'd fall unshadowed (vanilla's levels hold only the blocks').
vec3 heldLightUnshadowed(vec3 pos, vec3 n) {
	if (pc.lights == uvec2(0)) return vec3(0.0);
	LightTable table = LightTable(pc.lights);
	LightArray lights = LightArray(table.lights);
	vec3 sum = vec3(0.0);
	for (int j = 0; j < table.dims.w; j++) sum += lightContribution(lights.l[j], pos, n);
	return sum;
}

// Block lights by resampled importance sampling: CANDIDATES lights drawn from the 27 sections around pos
// (a section in proportion to its light count over its squared distance, then a light in it uniformly) and
// the held lights (each its own bucket, by its distance), one kept in proportion to its unshadowed
// contribution, then a single shadow ray to a point inside its block (stopping where the ray enters that
// block, which would otherwise hide its own light; for a held light, short of the hand holding it).
vec3 blockLight(vec3 pos, vec3 n, vec3 shading) {
	if (pc.lights == uvec2(0) || (off & OFF_BLOCK) != 0u) return vec3(0.0);
	LightTable table = LightTable(pc.lights);
	LightArray lights = LightArray(table.lights);
	ivec3 base = ivec3(floor(pos / 16.0));
	const int BUCKETS = 27 + MAX_HELD;
	int buckets = 27 + min(table.dims.w, MAX_HELD);
	uint first[BUCKETS], count[BUCKETS];
	float cdf[BUCKETS], total = 0.0;
	for (int j = 0; j < buckets - 27; j++) {
		vec3 d = lights.l[j].posEmission.xyz - pos;
		float d2 = dot(d, d);
		first[27 + j] = uint(j);
		count[27 + j] = 1u;
		total += d2 < 225.0 ? 1.0 / (d2 + 1.0) : 0.0;
		cdf[27 + j] = total;
	}
	// Sections after the held lights in the cdf: shift theirs by the held total.
	float heldTotal = total;
	total = 0.0;
	for (int i = 0; i < 27; i++) {
		ivec3 s = base + ivec3(i % 3 - 1, (i / 3) % 3 - 1, i / 9 - 1), c = s - table.origin.xyz;
		uvec2 cell = uvec2(0u);
		if (all(greaterThanEqual(c, ivec3(0))) && all(lessThan(c, table.dims.xyz)))
			cell = table.cells[(c.z * table.dims.y + c.y) * table.dims.x + c.x];
		vec3 nearest = clamp(pos, vec3(s) * 16.0, vec3(s) * 16.0 + 16.0);
		float d2 = dot(pos - nearest, pos - nearest);
		cell.y &= ~LIGHTS_NEAR;
		first[i] = cell.x;
		count[i] = cell.y;
		total += cell.y > 0u && d2 < 256.0 ? float(cell.y) / (d2 + 4.0) : 0.0;
		cdf[i] = total;
	}
	for (int j = 27; j < buckets; j++) cdf[j] += total;
	total += heldTotal;
	if (total == 0.0) return vec3(0.0);

	float weightSum = 0.0, chosenTarget = 0.0;
	uint chosen = 0u;
	vec3 chosenContribution = vec3(0.0);
	// Fewer candidates when stochastic: the denoiser (or accumulation) absorbs the extra noise.
	uint candidates = pc.stochastic != 0.0 ? lightCandidates : CANDIDATES;
	for (uint m = 0u; m < candidates; m++) {
		float u = rand() * total, below = 0.0;
		int i = 0, hi = buckets - 1; // the first bucket whose cdf passes u, by bisection
		while (i < hi) {
			int mid = (i + hi) >> 1;
			if (cdf[mid] <= u) i = mid + 1;
			else hi = mid;
		}
		if (i > 0) below = cdf[i - 1];
		uint index = first[i] + min(uint(rand() * float(count[i])), count[i] - 1u);
		float pdf = (cdf[i] - below) / total / float(count[i]);
		vec3 f = dot(n, lights.l[index].posEmission.xyz - pos) > 0.0 ? lightContribution(lights.l[index], pos, shading) : vec3(0.0);
		float target = luminance(f), weight = target / pdf;
		weightSum += weight;
		if (weight > 0.0 && rand() * weightSum < weight) {
			chosen = index;
			chosenTarget = target;
			chosenContribution = f;
		}
	}
	if (chosenTarget == 0.0) return vec3(0.0);

	vec3 centre = lights.l[chosen].posEmission.xyz;
	bool held = lights.l[chosen].colour.w != 0.0;
	vec3 toPoint = centre + (vec3(rand(), rand(), rand()) - 0.5) * (held ? 0.2 : 0.8) - pos;
	vec3 dir = normalize(toPoint);
	float tMax = held ? length(toPoint) - HELD_CLEAR : boxEntry(pos, dir, centre) - 0.01;
	vec3 lit = tMax > 0.0 ? shadowTransmittance(pos + n * 0.002, dir, tMax) : vec3(1.0);
	return lit * chosenContribution * (weightSum / (float(candidates) * chosenTarget));
}

vec3 heat(float x) {
	return clamp(vec3(x * 2.0 - 1.0, 1.0 - abs(x * 2.0 - 1.0), 1.0 - x * 2.0), 0.0, 1.0);
}

vec3 debugColour(rayQueryEXT rq, vec3 dir, uint mode) {
	uint id = uint(rayQueryGetIntersectionInstanceIdEXT(rq, true));
	if (mode == DEBUG_INSTANCES) {
		uint hash = id * 2654435761u;
		return vec3((hash >> 8) & 255u, (hash >> 16) & 255u, (hash >> 24) & 255u) / 255.0 * 0.8 + 0.2;
	}
	if (mode == DEBUG_TRIANGLE_DENSITY)
		return heat(clamp(log2(float(InstanceInfo(pc.instanceInfo).i[id].triangles)) / 14.0, 0.0, 1.0)); // 1 .. 16k
	Hit h = shade(rq, dir);
	if (mode == DEBUG_MATERIALS) { // grey albedo, tinted by what the shader reads the surface as
		vec3 grey = vec3(dot(pow(h.albedo, vec3(1.0 / 2.2)), vec3(0.33))) * 0.5 + 0.25;
		return h.water ? vec3(0.1, 0.3, 1.0) : h.glass ? vec3(0.2, 1.0, 1.0) : h.foliage ? vec3(0.1, 0.9, 0.1)
			: h.metal ? vec3(1.0, 0.85, 0.1) : h.gem ? vec3(1.0, 0.2, 1.0) : h.emission > 0.0 ? vec3(1.0, 0.2, 0.1) : grey;
	}
	if (mode == DEBUG_PBR_NORMAL) return h.pbrNormal.rgb;
	if (mode == DEBUG_PBR_SPECULAR) return h.pbrSpecular.rgb;
	return mode == DEBUG_NORMALS ? h.shading * 0.5 + 0.5 : pow(h.albedo, vec3(1.0 / 2.2));
}

// AgX (Sobotka; Wrensch's polynomial fit): linear radiance -> display-linear [0, 1]. Highlights roll off
// towards white instead of skewing hue. Inset, log2 encoding over AGX_MIN_EV..AGX_MAX_EV, sigmoid, outset.
const mat3 AGX_IN = mat3(0.842479062253094, 0.0423282422610123, 0.0423756549057051,
	0.0784335999999992, 0.878468636469772, 0.0784336,
	0.0792237451477643, 0.0791661274605434, 0.879142973793104);
const mat3 AGX_OUT = mat3(1.19687900512017, -0.0528968517574562, -0.0529716355144438,
	-0.0980208811401368, 1.15190312990417, -0.0980434501171241,
	-0.0990297440797205, -0.0989611768448433, 1.15107367264116);
const float AGX_MIN_EV = -12.47393, AGX_MAX_EV = 4.026069;
const float AGX_SATURATION = 1.2; // the look: base AgX greyed Minecraft's colours (grass, ice) more than ACES did
const vec3 AGX_LUMA = vec3(0.2126, 0.7152, 0.0722);

vec3 agxCurve(vec3 x) {
	vec3 x2 = x * x, x4 = x2 * x2;
	return 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x + 0.4298 * x2 + 0.1191 * x - 0.00232;
}

vec3 tonemap(vec3 x) {
	x = clamp(log2(max(AGX_IN * max(x, vec3(0.0)), vec3(1e-10))), AGX_MIN_EV, AGX_MAX_EV);
	x = agxCurve((x - AGX_MIN_EV) / (AGX_MAX_EV - AGX_MIN_EV));
	float luma = dot(x, AGX_LUMA);
	x = luma + AGX_SATURATION * (x - luma);
	return clamp(pow(max(AGX_OUT * x, vec3(0.0)), vec3(2.2)), 0.0, 1.0);
}

// Sun or moon (one shadow ray toward a point on the disc, its centre unless stochastic) plus block lights.
vec3 directLight(Hit h, vec3 pos, bool seen) {
	bool day = pc.sunDir.y > 0.0;
	vec3 lightDir = day ? pc.sunDir.xyz : pc.moonDir.xyz;
	vec3 direct = vec3(0.0);
	if (pc.skyColor.w != 0.0 && lightDir.y > 0.0) {
		vec3 l = pc.stochastic != 0.0 ? sampleCone(lightDir, day ? SUN_COS : MOON_COS, vec2(rand(), rand())) : lightDir;
		float nl = dot(h.normal, l) > 0.0 ? dot(h.shading, l) : dot(h.normal, l);
		vec3 side = h.normal;
		if (h.transmission > 0.0 && nl < 0.0) { // lit from behind: some of it comes through
			nl *= -h.transmission;
			side = -side;
		}
		if (nl > 0.0) direct = nl * ((off & OFF_SUN) != 0u ? vec3(1.0) : shadowTransmittance(pos + side * 0.002, l, 512.0)) * (day ? sunRadiance(l.y) : moonRadiance(l.y)) * cloudShadow(pos, l);
	}
	// Hybrid lighting takes vanilla's level as the light itself, raster-style. Path traced block light isn't gated
	// by vanilla's level alone: that ends at a Manhattan distance (a torch's at 14 blocks along an axis, 8 on the
	// diagonal), where lightContribution's 15-block window was still well above zero, so the light cut off in a
	// stepped edge. Past it, on surfaces seen (from the camera, through glass or water, in reflections), lightsNear
	// says whether any light could still reach (skipping it, coherently across a warp, out in the dark). Bounces and
	// the cache's paths, where the edge doesn't show, keep the gate (but for held lights, which vanilla's levels
	// don't know of): sampling past it everywhere cost 2 ms at night by the portal.
	if (hybrid) direct += BLOCK_LIGHT * pow(h.light.x, 2.2) + heldLightUnshadowed(pos, h.shading);
	else if (h.light.x > 0.0 || lightsNear(pos, seen)) direct += blockLight(pos, h.normal, h.shading);
	return direct;
}

// Cosine-weighted direction around n. With radiance = albedo x irradiance (no 1/pi, as everywhere here), a
// sample's contribution is simply albedo x the radiance arriving along it.
vec3 cosineSample(vec3 n) {
	float u = rand(), phi = 6.2831853 * rand(), r = sqrt(u);
	vec3 t = normalize(cross(abs(n.y) < 0.99 ? vec3(0, 1, 0) : vec3(1, 0, 0), n));
	return normalize(t * (r * cos(phi)) + cross(n, t) * (r * sin(phi)) + n * sqrt(1.0 - u));
}

// A bounce direction: the surface's first bounce leaves around its normal-mapped normal (so bumps shape bounce
// light too), mirrored back above the real face if it dips below; later ones around n. n is the side the ray
// leaves from (foliage may have flipped it): the shading normal only applies on the side it was made for.
// ponytail: mirroring skews the cosine lobe a little at steep bumps.
vec3 firstBounce(bool first, vec3 n, vec3 shading) {
	vec3 d = cosineSample(first && dot(n, shading) > 0.0 ? shading : n);
	return dot(d, n) > 0.0 ? d : reflect(d, n);
}

// Light a surface a bounce ray hits gives off by itself: light blocks' glow is already counted by light sampling.
vec3 glow(Hit h) {
	return h.listed ? vec3(0.0) : h.albedo * (EMISSIVE * h.emission);
}

bool cacheOn, feeding; // Frame.cache set; this pixel feeds the cache (its first surface's path only)
CacheCells cells;
CacheSums sums;
ivec3 anchor;

// A cache cell's two hashes: where it sits and a check. Cells are 1/4 block, doubling every time the distance
// from the camera does past 8 blocks (to 16); one per face direction.
// coarser: 0 for pos's own cell, 1 for the cell twice its size around it (fed too, read where pos's is empty).
void cacheKey(vec3 pos, vec3 n, int coarser, out uint slot, out uint check) {
	int level = min(clamp(int(log2(max(length(pos - pc.cameraInScene.xyz) / 8.0, 1.0))), 0, 6) + coarser, 6);
	vec3 a = abs(n);
	uint face = a.x > a.y && a.x > a.z ? (n.x > 0.0 ? 0u : 1u) : a.y > a.z ? (n.y > 0.0 ? 2u : 3u) : (n.z > 0.0 ? 4u : 5u);
	// The anchor is a multiple of 16, so whole cells: (anchor * 4) >> level in cells of 0.25 * 2^level.
	uvec3 c = uvec3(((anchor * 4) >> level) + ivec3(floor((pos + n * 0.01) * (4.0 / float(1 << level)))));
	uint tag = uint(level) * 6u + face;
	slot = pcg(c.x + pcg(c.y + pcg(c.z + pcg(tag))));
	check = max(pcg(c.z + pcg(c.x + pcg(c.y + pcg(tag + 0x51ED27u)))), 1u);
}

// The cell's entry, or -1: missing (lookups), or no free slot left near its hash (inserts).
int cacheEntry(uint slot, uint check, bool insert) {
	uint base = slot & (CACHE_SIZE - 1u) & ~(CACHE_PROBES - 1u);
	for (uint i = 0u; i < CACHE_PROBES; i++)
		if (cells.c[base + i].check == check) return int(base + i);
	if (!insert) return -1;
	for (uint i = 0u; i < CACHE_PROBES; i++) {
		uint previous = atomicCompSwap(cells.c[base + i].check, 0u, check);
		if (previous == 0u || previous == check) return int(base + i);
	}
	return -1;
}

// A sample goes to its cell and to the coarser cell around it.
void cacheAdd(vec3 pos, vec3 n, vec3 irradiance) {
	if (any(isnan(irradiance))) return;
	uvec3 fixedPoint = uvec3(min(irradiance, vec3(CACHE_MAX)) * CACHE_FIXED + 0.5);
	for (int coarser = 0; coarser < 2; coarser++) {
		uint slot, check;
		cacheKey(pos, n, coarser, slot, check);
		int i = cacheEntry(slot, check, true);
		if (i < 0) continue;
		atomicAdd(sums.s[i].sum.x, fixedPoint.x);
		atomicAdd(sums.s[i].sum.y, fixedPoint.y);
		atomicAdd(sums.s[i].sum.z, fixedPoint.z);
		atomicAdd(sums.s[i].count, 1u);
	}
}

// pos's cell, or where that has no average yet, the coarser one around it. Bounce rays reach surfaces the feeding
// paths seldom do; a miss falls back to a far dimmer estimate (direct light and the sky fill by vanilla's level),
// and in places lit mostly through the cache (an underwater tunnel at night) those misses were dark specks.
bool cacheLookup(vec3 pos, vec3 n, out vec3 irradiance) {
	for (int coarser = 0; coarser < 2; coarser++) {
		uint slot, check;
		cacheKey(pos, n, coarser, slot, check);
		int i = cacheEntry(slot, check, false);
		if (i < 0) continue;
		uvec2 v = cells.c[i].value;
		vec2 bn = unpackHalf2x16(v.y);
		irradiance = vec3(unpackHalf2x16(v.x), bn.x);
		if (bn.y > 0.0) return true; // averaged at least once
	}
	return false;
}

// Light reaching a bounce ray's hit: the cache's, or (not cached yet) its direct light and the sky fill.
vec3 bounceIrradiance(Hit h, vec3 pos) {
	vec3 e;
	if (cacheLookup(pos, h.normal, e)) return e;
	return directLight(h, pos, false) + skyIrradiance(h.shading) * h.light.y * h.light.y * SKY_FILL * h.ao;
}

// Light arriving at a surface by one bounce, with the cache past it. A feeding pixel follows the path
// CACHE_PATH bounces and adds the light that reached each surface (its direct light included) to its cell.
vec3 cachedBounce(Hit h, vec3 pos, vec3 direct) {
	if ((off & OFF_BOUNCE) != 0u) return vec3(0.0);
	bool feed = feeding;
	feeding = false;
	int steps = feed ? CACHE_PATH : 1, last = 0;
	vec3 xs[CACHE_PATH], ns[CACHE_PATH], ds[CACHE_PATH], transfer[CACHE_PATH], glows[CACHE_PATH];
	xs[0] = pos;
	ns[0] = h.normal;
	ds[0] = direct;
	vec3 x = pos, n = h.normal, bounce = vec3(0.0);
	float transmission = h.transmission;
	for (int k = 0; k < steps; k++) {
		float w = 1.0;
		if (transmission > 0.0) { // as in surfaceRadiance
			if (rand() * (1.0 + transmission) < transmission) n = -n;
			w = 1.0 + transmission;
		}
		vec3 d = firstBounce(k == 0, n, h.shading);
		rayQueryEXT b;
		TRACE(b, x + n * 0.002, d, 512.0, MASK_OPAQUE_SCENE, gl_RayFlagsNoneEXT)
		last = k;
		if (!HIT(b)) {
			bounce = w * skyIrradiance(d);
			break;
		}
		vec3 xb = x + n * 0.002 + d * rayQueryGetIntersectionTEXT(b, true);
		Hit hb = shade(b, d);
		transfer[k] = w * hb.albedo;
		glows[k] = w * glow(hb);
		if (k == steps - 1) {
			bounce = transfer[k] * bounceIrradiance(hb, xb) + glows[k];
			break;
		}
		xs[k + 1] = x = xb;
		ns[k + 1] = n = hb.normal;
		ds[k + 1] = directLight(hb, xb, false);
		transmission = hb.transmission;
	}
	// Back along the path: each surface's light is its direct light plus what its bounce brought.
	for (int i = last; feed && i >= 0; i--) {
		vec3 e = ds[i] + bounce;
		cacheAdd(xs[i], ns[i], e);
		if (i > 0) bounce = transfer[i - 1] * e + glows[i - 1];
	}
	return bounce;
}

// Bounces followed when stochastic (Frame.cameraDelta.w: 3 for the reference, 1 under RR); Russian roulette
// after the second.
int bounces;
float lightFloor, caveFloor, nightFloor; // Frame.lightFloor, Frame.caveFloor, Frame.nightFloor

// Light leaving an opaque (or textured translucent) surface back along the ray: its emission and direct
// light, plus bounce light (approximated, or followed when stochastic).
vec3 surfaceRadiance(Hit h, vec3 pos) {
	if (h.portal) return h.albedo * (EMISSIVE * h.emission);
	// A floor (vanilla's Brightness, scaled down by Cave Brightness where no sky light reaches) so caves and dense
	// foliage never go black; when stochastic, also a share of sky light by vanilla's sky level, for the bounces
	// past the one followed (the radiance cache's job, when on).
	// The floor: caves keep caveFloor of it at any hour; open air keeps it by day, nightFloor of it at night.
	vec3 ambient = (vec3(lightFloor * mix(caveFloor, mix(nightFloor, 1.0, pc.sunDir.w), h.light.y)) + (pc.stochastic != 0.0 && !cacheOn ? skyIrradiance(h.shading) * h.light.y * h.light.y * SKY_FILL : vec3(0.0))) * h.ao;
	vec3 direct = directLight(h, pos, true);
	vec3 radiance = h.albedo * (EMISSIVE * h.emission + direct + ambient);
	if (cacheOn) return radiance + h.albedo * h.ao * cachedBounce(h, pos, direct);
	if (pc.stochastic == 0.0) {
		// ponytail: until M4's denoiser, bounce light is approximated outside reference mode: sky light scaled by
		// vanilla's sky light level, and a dim fill from its block light level.
		float sky = h.light.y * h.light.y;
		// (Hybrid lighting already counts block light in full in directLight.)
		vec3 fill = hybrid ? vec3(0.0) : BLOCK_LIGHT * 0.15 * pow(h.light.x, 2.2);
		return radiance + h.albedo * h.ao * (skyIrradiance(h.shading) * sky + fill);
	}

	// Stochastic: follow the light around. Each bounce picks up direct light where it lands; a ray that
	// escapes brings the sky's. Light blocks a bounce hits add no glow: block-light sampling already counted them.
	vec3 throughput = h.albedo * h.ao, x = pos, n = h.normal;
	float transmission = h.transmission;
	for (int bounce = 0; bounce < bounces; bounce++) {
		// Foliage scatters to either side: through it with probability T / (1 + T), weighted to match.
		if (transmission > 0.0) {
			if (rand() * (1.0 + transmission) < transmission) n = -n;
			throughput *= 1.0 + transmission;
		}
		vec3 d = firstBounce(bounce == 0, n, h.shading);
		rayQueryEXT b;
		TRACE(b, x + n * 0.002, d, 512.0, MASK_OPAQUE_SCENE, gl_RayFlagsNoneEXT)
		if (!HIT(b)) {
			radiance += throughput * skyIrradiance(d);
			break;
		}
		x = x + n * 0.002 + d * rayQueryGetIntersectionTEXT(b, true);
		Hit hb = shade(b, d);
		radiance += throughput * (hb.albedo * directLight(hb, x, false) + glow(hb));
		throughput *= hb.albedo;
		n = hb.normal;
		transmission = hb.transmission;
		if (bounce >= 1) {
			float survive = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 0.95);
			if (rand() > survive) break;
			throughput /= survive;
		}
	}
	return radiance;
}

// How far d points from the centre of vanilla's square sun or moon towards c, as half-width over distance
// (> 1e9 behind it). Vanilla's quad has one edge along world Z, the axis the sky turns around.
float celestialOffset(vec3 d, vec3 c) {
	float z = dot(d, c);
	vec3 across = cross(c, vec3(0.0, 0.0, 1.0));
	return z > 0.0 ? max(abs(d.z), abs(dot(d, across))) / z : 1e10;
}

// A layer of stars on a grid of cells (q: a direction scaled to cells per radian): a cell holds one with the
// given probability, a point about a pixel wide; magnitudes fall off steeply (most faint, a few bright), colours
// run blue-white to orange like stars' temperatures. Each twinkles at its own pace, by up to twinkle.
vec3 starLayer(vec3 q, float probability, float size, float twinkle) {
	vec3 cell = floor(q);
	uint h = pcg(uint(int(cell.x) + 100000) + pcg(uint(int(cell.y) + 100000) + pcg(uint(int(cell.z) + 100000))));
	if (float(h % 100000u) >= probability * 100000.0) return vec3(0.0);
	vec3 centre = cell + 0.5 + (vec3(pcg(h), pcg(h + 1u), pcg(h + 2u)) / 4294967295.0 - 0.5) * 0.5;
	float magnitude = pow(float(pcg(h + 3u)) / 4294967295.0, 6.0), t = float(pcg(h + 4u)) / 4294967295.0;
	vec3 colour = t < 0.1 ? vec3(0.7, 0.8, 1.0) : t < 0.75 ? vec3(1.0, 0.98, 0.95) : t < 0.93 ? vec3(1.0, 0.9, 0.75) : vec3(1.0, 0.75, 0.55);
	float r = length(q - centre) / size;
	float seconds = cloudTime * 0.5; // game time: cloudTime drifts 0.1 blocks a tick, 20 ticks a second
	float rate = 1.5 + 2.5 * float(pcg(h + 5u) % 1000u) / 1000.0, phase = float(pcg(h + 6u) % 1000u) * 0.00628;
	float flicker = 1.0 + twinkle * sin(seconds * 6.2831853 * rate + phase) * sin(seconds * 3.9 * rate + phase * 1.7);
	return colour * magnitude * flicker * exp(-4.0 * r * r);
}

// The night sky far from towns (user): thousands of twinkling stars (more near the horizon, through more air),
// denser along the Milky Way, a band of glow all the way round with a brighter core, clumps and dark dust lanes.
// All turn with the sun (vanilla's sky turns around world Z) and wash out under a bright moon. Stars fade with
// vanilla's star brightness (0 by day and in rain, 0.5 at night); the Milky Way more slowly, through twilight.
vec3 nightSky(vec3 d) {
	float moonWash = 1.0 - 0.7 * moonLit() * smoothstep(-0.05, 0.15, pc.moonDir.y);
	float fade = pc.skyColor.y * 2.0 * moonWash;
	float glowFade = (1.0 - smoothstep(-0.35, -0.02, pc.sunDir.y)) * pc.moonDir.w * moonWash;
	if (fade <= 0.0 && glowFade <= 0.0) return vec3(0.0);
	float a = atan(pc.sunDir.x, pc.sunDir.y), c = cos(a), s = sin(a);
	vec3 r = vec3(c * d.x - s * d.y, s * d.x + c * d.y, d.z); // in the sky's own frame
	vec3 pole = normalize(vec3(0.42, 0.55, 0.72)), core = normalize(cross(pole, vec3(0.0, 0.0, 1.0)));
	float lat = dot(r, pole), band = exp(-lat * lat / (2.0 * 0.16 * 0.16));
	float toCore = acos(clamp(dot(r, core), -1.0, 1.0)), centre = exp(-toCore * toCore / (2.0 * 0.6 * 0.6));
	float clumps = textureLod(cloudNoise, r * 0.8 + 0.5, 0.0).r, fine = textureLod(cloudNoise, r * 6.0, 0.0).r;
	float dust = smoothstep(0.3, 0.8, textureLod(cloudNoise, r * 2.5 + 0.3, 0.0).g);
	float lanes = 1.0 - 0.75 * exp(-lat * lat / (2.0 * 0.035 * 0.035)) * dust;
	vec3 milkyWay = mix(vec3(0.8, 0.85, 1.0), vec3(1.0, 0.88, 0.7), centre)
		* band * (0.35 + 0.65 * clumps) * (0.6 + 0.8 * fine) * (0.6 + 1.2 * centre) * lanes * MILKY_WAY;
	// Two layers, so the grid doesn't show; about a pixel wide at 1440p's ~0.0015 rad a pixel.
	float twinkle = mix(0.6, 0.15, clamp(d.y * 3.0, 0.0, 1.0));
	vec3 starlight = starLayer(r * 350.0, 0.012 * (1.0 + 4.0 * band * lanes), 0.45, twinkle)
		+ starLayer(r * 220.0 + 17.0, 0.006 * (1.0 + 2.0 * band), 0.35, twinkle);
	return milkyWay * glowFade + starlight * (STAR * fade);
}

// The moon's face where d meets it: 16x16 grey pixels like vanilla's, the part vanilla's phase leaves dark
// unlit (waning from one side, waxing from the other).
float moonFace(vec3 d) {
	vec3 m = pc.moonDir.xyz, across = cross(m, vec3(0.0, 0.0, 1.0));
	float z = dot(d, m);
	vec2 uv = vec2(dot(d, across), d.z) / (z * MOON_SIZE) * 0.5 + 0.5; // 0..1 across the face
	ivec2 cell = clamp(ivec2(uv * 16.0), ivec2(0), ivec2(15));
	float grey = 0.65 + 0.35 * float(pcg(uint(cell.x) + pcg(uint(cell.y) + 0x9E3779B9u)) % 1000u) / 1000.0;
	int phase = int(pc.skyColor.x + 0.5);
	float lit = abs(float(phase) - 4.0) * 0.25; // share of the face lit: 1 at full moon, 0 at new
	float x = (float(cell.x) + 0.5) / 16.0;
	bool shown = phase == 0 || (phase < 4 ? x < lit : phase > 4 && x > 1.0 - lit);
	return grey * (shown ? 1.0 : 0.03);
}

// What a ray that escapes sees: the physically based sky (Sky.java), stars, and the sun and moon as vanilla's
// squares with their light through the atmosphere.
vec3 skyRadiance(vec3 d) {
	if (pc.skyColor.w == 0.0) return srgbToLinear(pc.fogColor.rgb) * 0.15;
	// Below the horizon the horizon's haze goes on, darkening downwards like distant ground in haze (no ground out
	// there: the world ends at the render distance, its edge fading into this).
	float elevation = asin(clamp(d.y, 0.0, 1.0)), s = sqrt(elevation / 1.5707963);
	float ground = mix(1.0, 0.45, smoothstep(0.0, 0.35, -d.y));
	vec3 c = overcast(textureLod(skyViewLut, vec2(atan(d.z, d.x) / 6.2831853 + 0.5, s * 0.5 + 0.5), 0.0).rgb) * (SKY * ground);
	if (d.y > 0.0) c += nightSky(d) * atmosphereTransmittance(d.y);
	if (pc.sunDir.y > -0.1) {
		float k = celestialOffset(d, pc.sunDir.xyz);
		// Only the core: the atmosphere (sky.comp's Mie scattering) and bloom make the glow vanilla's texture paints.
		if (k < SUN_SIZE) c += sunRadiance(pc.sunDir.y) * GLINT * pc.moonDir.w; // gone behind rain clouds, as vanilla's
	}
	if (pc.moonDir.y > -0.1 && celestialOffset(d, pc.moonDir.xyz) < MOON_SIZE) c += moonFace(d) * moonRadiance(pc.moonDir.y) * MOON_GLINT * pc.moonDir.w;
	return c;
}


void enterWater(vec3 tint, float skyLight) {
	waterSigma = -log(max(tint, vec3(0.01))) * WATER_ABSORPTION;
	vec3 sun = pc.sunDir.y > 0.0 ? sunRadiance(pc.sunDir.y) * pc.sunDir.y : moonRadiance(pc.moonDir.y) * max(pc.moonDir.y, 0.0);
	waterGlow = tint * (skyIrradiance(vec3(0.0, 1.0, 0.0)) + sun * pc.skyColor.w) * skyLight * skyLight * WATER_SCATTER;
}

// Through d blocks of water: light from behind is absorbed per channel and the water's glow fills in.
void throughWater(float d, inout vec3 result, inout vec3 weight) {
	vec3 t = exp(-waterSigma * d);
	result += weight * waterGlow * (1.0 - t);
	weight *= t;
}

float reflectionDistance; // set by reflectionSeen(): how far its ray went (SKY_DISTANCE: nothing hit)

// Light leaving a surface a reflection ray hit (M7 step 2), under RR: the radiance cache's light there (direct and bounced
// both, so no shadow or bounce rays), or where it has none yet, its direct light and the sky fill. ponytail:
// shadows seen in reflections soften to the cache's cells (1/4 block near the camera, coarser far off).
vec3 reflectedRadiance(Hit h, vec3 pos) {
	if (!cacheOn || h.portal) return surfaceRadiance(h, pos); // the reference (and no RR): in full
	vec3 ambient = vec3(lightFloor * mix(caveFloor, mix(nightFloor, 1.0, pc.sunDir.w), h.light.y)) * h.ao;
	vec3 e;
	if (!cacheLookup(pos, h.normal, e))
		e = directLight(h, pos, true) + skyIrradiance(h.shading) * h.light.y * h.light.y * SKY_FILL * h.ao;
	return h.albedo * (EMISSIVE * h.emission + e + ambient);
}

// What a reflection ray from origin along r sees, or miss if nothing. Stained glass, ice and nether portals show,
// over what lies behind them; water doesn't (cutoutHit).
vec3 reflectionSeen(vec3 origin, vec3 r, vec3 miss) {
	rayQueryEXT rq;
	reflectionRay = true;
	TRACE(rq, origin, r, 512.0, MASK_OPAQUE_SCENE | MASK_NOT_ONLY_WATER, gl_RayFlagsNoneEXT)
	reflectionRay = false;
	reflectionDistance = SKY_DISTANCE;
	if (!HIT(rq)) { // the sky, with its clouds
		vec4 cloud = clouds(origin, r, 1e9);
		return miss * cloud.a + cloud.rgb;
	}
	float t = rayQueryGetIntersectionTEXT(rq, true);
	reflectionDistance = t;
	Hit h = shade(rq, r);
	vec3 c = reflectedRadiance(h, origin + r * t);
	if (h.kind != KIND_TRANSLUCENT) return c;
	// ponytail: one translucent layer; a second one behind it is skipped.
	rayQueryEXT bq;
	reflectionRay = true;
	TRACE(bq, origin + r * (t + 0.002), r, 512.0, MASK_OPAQUE_SCENE, gl_RayFlagsNoneEXT)
	reflectionRay = false;
	vec3 behind = HIT(bq) ? reflectedRadiance(shade(bq, r), origin + r * (t + 0.002 + rayQueryGetIntersectionTEXT(bq, true))) : miss;
	return mix(behind, c, h.opacity);
}

// Microfacet normal around n, GGX distributed for alpha = roughness².
vec3 ggxNormal(vec3 n, float alpha) {
	float u = rand(), phi = 6.2831853 * rand();
	float c = sqrt((1.0 - u) / (1.0 + (alpha * alpha - 1.0) * u)), s = sqrt(1.0 - c * c);
	vec3 t = normalize(cross(abs(n.y) < 0.99 ? vec3(0, 1, 0) : vec3(1, 0, 0), n));
	return normalize(t * (s * cos(phi)) + cross(n, t) * (s * sin(phi)) + n * c);
}

// Light a polished surface at pos reflects back along dir: a mirror ray, spread by roughness when stochastic.
// n: the geometric normal (offsets, what's above the surface); shading: the normal-mapped one the lobe is around.
vec3 specularRadiance(vec3 pos, vec3 n, vec3 shading, vec3 dir, float roughness) {
	if ((off & OFF_SPECULAR) != 0u) return vec3(0.0);
	vec3 r = reflect(dir, pc.stochastic != 0.0 ? ggxNormal(shading, roughness * roughness) : shading);
	if (dot(r, n) <= 0.0) r = reflect(r, n); // below the real face: mirror back above it
	return reflectionSeen(pos + n * 0.002, r, skyRadiance(r));
}

// Set by radiance(): what the primary ray hit first (an entity, or water / glass / ice), at this NDC depth.
bool hitEntity, hitTranslucent;
float hitDepth;
// And RR's guides for it: albedo of what's seen (blended through water and glass), the first surface's
// reflectance, normal, roughness and position relative to the camera.
vec3 guideAlbedo, guideSpecular, guideNormal, guidePos;
float guideRoughness, guideHitDistance; // hit distance: of the first surface's reflection ray, for RR's reflections
vec3 guideMotion; // an entity hit's motion offset (Hit.motion)

// Linear radiance seen through pixel position `pixel` (fractional); coverage 0 where vanilla's picture stays.
vec4 radiance(vec2 pixel, vec2 size, uvec2 p) {
	hitEntity = false;
	hitTranslucent = false;
	// Primary ray, matching vanilla's projection. View bobbing translates inside the projection, so the eye
	// isn't at the origin: unproject the near plane (reversed-Z: ndc 1) as well.
	vec2 ndc = pixel / size * 2.0 - 1.0;
	vec4 near = pc.invViewProj * vec4(ndc, 1.0, 1.0), mid = pc.invViewProj * vec4(ndc, 0.5, 1.0);
	vec3 origin = near.xyz / near.w;
	vec3 dir = normalize(mid.xyz / mid.w - origin);
	vec3 camera = pc.cameraInScene.xyz + origin;

	// Terrain, entities and translucent terrain; vanilla draws particles and overlays over this afterwards.
	rayQueryEXT rq;
	TRACE_CAMERA(rq, camera, dir, 1024.0, MASK_OPAQUE_SCENE | MASK_TRANSLUCENT)
	if (!HIT(rq)) return vec4(0.0);
	float t = rayQueryGetIntersectionTEXT(rq, true);
	vec3 pos = camera + dir * t;
	Hit h = shade(rq, dir);
	fogSkyLight = h.light.y;
	if (h.kind == KIND_TRANSLUCENT) {
		// Vanilla still draws translucent sections past the RT distance (Scene.tracesTranslucent): look through.
		ivec2 section = ivec2(floor((pos.xz - h.normal.xz * 0.01) / 16.0));
		if (any(greaterThan(abs(section), ivec2(int(pc.rtDistance) / 16)))) {
			TRACE_CAMERA(rq, camera, dir, 1024.0, MASK_OPAQUE_SCENE)
			if (!HIT(rq)) return vec4(0.0);
			t = rayQueryGetIntersectionTEXT(rq, true);
			pos = camera + dir * t;
			h = shade(rq, dir);
		}
	}
	guidePos = pos - pc.cameraInScene.xyz;
	guideMotion = h.motion;
	guideNormal = h.shading;
	guideRoughness = h.kind == KIND_TRANSLUCENT || h.glass ? 0.0 : 1.0;
	guideAlbedo = guideSpecular = vec3(0.0);
	guideHitDistance = 0.0;
	if (h.kind == KIND_DYNAMIC || h.kind == KIND_TRANSLUCENT || h.glass) {
		vec4 clip = pc.viewProj * vec4(guidePos, 1.0);
		hitEntity = h.kind == KIND_DYNAMIC;
		hitTranslucent = !hitEntity;
		hitDepth = clip.z / clip.w;
	}

	// Past the RT distance the terrain thins out; leave vanilla's picture there, shaded alike (vanillaRadiance).
	// Over the last RT_BLEND of it, on a circle (the traced area is square, which showed as a straight seam),
	// the traced picture fades into that: covered, its share. Entities are always traced (vanilla no longer
	// draws them).
	float covered = 1.0;
	vec2 d = abs(pos.xz - camera.xz);
	if ((off & OFF_BLEND) != 0u && h.kind < KIND_TRANSLUCENT && max(d.x, d.y) > pc.rtDistance) return vec4(0.0);
	if ((off & OFF_TRACED) != 0u && h.kind < KIND_TRANSLUCENT) return vec4(0.0);
	if ((off & OFF_BLEND) == 0u && h.kind < KIND_TRANSLUCENT) {
		float band = max(16.0, pc.rtDistance * RT_BLEND);
		covered = 1.0 - smoothstep(pc.rtDistance - band, pc.rtDistance, length(pos.xz - camera.xz));
		if (covered <= 0.0) return vec4(0.0);
	}

	// Through water, glass and ice: each surface reflects (the first one only, ponytail: one reflection ray per
	// pixel), shows its texture lit like any surface, and lets the rest through, bent by the refraction indices
	// on either side. Water also absorbs along the way. Surfaces are crossed in pairs (in, out), so the medium
	// is tracked by toggling.
	vec3 result = vec3(0.0), weight = vec3(1.0);
	bool inWater = pc.fogColor.w != 0.0, inGlass = false, reflected = false;
	// Where RR's guides sit when the first surface is mostly seen through: on what's behind it, at its distance
	// along the unbent view ray (Portal RTX's primary surface replacement), so it reprojects with its own
	// parallax instead of the water's or glass's. The normal stays the surface's, for its reflection.
	vec3 viewDir = dir;
	float travelled = t;
	bool replace = false;
	if (inWater) {
		waterSigma = -log(WATER_TINT) * WATER_ABSORPTION;
		waterGlow = srgbToLinear(pc.fogColor.rgb); // vanilla's underwater fog: what deep water looks like
	}
	for (int layer = 0; ; layer++) {
		if (inWater && !inGlass) throughWater(t, result, weight);
		if (h.kind != KIND_TRANSLUCENT && !h.glass || layer == MAX_LAYERS - 1) {
			if (replace) {
				guidePos = camera + viewDir * travelled - pc.cameraInScene.xyz;
				guideMotion = h.motion;
			}
			vec3 diffuse = vec3(1.0);
			if (h.specular) {
				// Schlick, its grazing rise held down on rough surfaces (Fdez-Agüera).
				vec3 f = h.f0 + (max(vec3(1.0 - h.roughness), h.f0) - h.f0) * pow(1.0 - clamp(-dot(dir, h.shading), 0.0, 1.0), 5.0);
				result += weight * f * specularRadiance(pos, h.normal, h.shading, dir, h.roughness);
				diffuse = (1.0 - f) * h.diffuse;
				if (layer == 0) {
					guideSpecular = f;
					guideRoughness = h.roughness;
					guideHitDistance = reflectionDistance;
				}
			}
			result += weight * diffuse * surfaceRadiance(h, pos);
			guideAlbedo += weight * diffuse * h.albedo;
			break;
		}

		bool nextWater = h.water != inWater, nextGlass = h.glass != inGlass;
		float n1 = inGlass ? GLASS_IOR : inWater ? WATER_IOR : 1.0, n2 = nextGlass ? GLASS_IOR : nextWater ? WATER_IOR : 1.0;
		float f0 = (n1 - n2) * (n1 - n2) / ((n1 + n2) * (n1 + n2));
		// Water's top faces take the waves' normal (on the side the ray comes from); offsets keep the real face's.
		vec3 wn = h.water && abs(h.normal.y) > 0.5 ? waveNormal(pos) * sign(h.normal.y) : h.normal;
		vec3 through = refract(dir, wn, n1 / n2);
		bool total = dot(through, through) == 0.0; // total internal reflection
		float cosine = n1 > n2 ? -dot(through, wn) : -dot(dir, wn); // the larger angle's
		float fresnel = total ? 1.0 : n1 == n2 ? 0.0 : f0 + (1.0 - f0) * pow(1.0 - clamp(cosine, 0.0, 1.0), 5.0);
		bool separate = !reflected; // this surface's reflection traced on its own (the first surface only)
		if (!reflected) {
			reflected = true;
			guideSpecular = vec3(fresnel);
			vec3 r = reflect(dir, wn), keep = weight * fresnel;
			if (dot(r, h.normal) <= 0.0) r = reflect(r, h.normal); // a wave tilted it under the surface: back above
			vec3 seen = reflectionSeen(pos + h.normal * 0.002, r, inWater ? waterGlow : skyRadiance(r));
			guideHitDistance = reflectionDistance;
			if (reflectionDistance < SKY_DISTANCE && inWater && !inGlass) throughWater(reflectionDistance, result, keep);
			result += keep * seen;
		}
		// Past the first surface the ray itself bounces off instead: always under total internal reflection (else
		// glass goes black where it reflects inside), otherwise by chance when stochastic (the chance stands in for
		// the Fresnel weight). It stays in the same medium.
		vec3 from;
		if (!separate && (total || pc.stochastic != 0.0 && rand() < fresnel)) {
			dir = reflect(dir, wn);
			if (dot(dir, h.normal) <= 0.0) dir = reflect(dir, h.normal);
			from = pos + h.normal * 0.002;
		} else {
			weight *= separate || pc.stochastic == 0.0 ? 1.0 - fresnel : 1.0;
			float opacity = h.opacity * (h.water ? WATER_OPACITY : 1.0);
			if (layer == 0) replace = (1.0 - fresnel) * (1.0 - opacity) > fresnel;
			result += weight * opacity * surfaceRadiance(h, pos);
			guideAlbedo += weight * opacity * h.albedo;
			weight *= 1.0 - opacity;
			if (max(weight.r, max(weight.g, weight.b)) < 0.01) break;

			if (nextWater && !inWater) enterWater(h.tint, h.light.y);
			inWater = nextWater;
			inGlass = nextGlass;
			dir = dot(through, h.normal) < 0.0 ? through : refract(dir, h.normal, n1 / n2); // a wave can't turn it back
			from = pos - h.normal * 0.002;
		}
		TRACE_CAMERA(rq, from, dir, 512.0, MASK_OPAQUE_SCENE | MASK_TRANSLUCENT)
		if (!HIT(rq)) {
			result += weight * (inWater && !inGlass ? waterGlow : skyRadiance(dir));
			if (replace) guidePos = viewDir * 4096.0; // sky through glass: far away, barely moving
			break;
		}
		t = rayQueryGetIntersectionTEXT(rq, true);
		travelled += t;
		pos = from + dir * t;
		h = shade(rq, dir);
	}
	return vec4(result, covered);
}

// Inverse of tonemap() after vanilla's gamma: the linear radiance that would come out as this sRGB colour
// (the curve by bisection; it rises over 0..1). Colours AgX can't reach come back as the nearest it can.
vec3 untonemap(vec3 srgb) {
	vec3 target = inverse(AGX_OUT) * srgb, lo = vec3(0.0), hi = vec3(1.0);
	float luma = dot(target, AGX_LUMA);
	target = luma + (target - luma) / AGX_SATURATION;
	for (int i = 0; i < 16; i++) {
		vec3 mid = (lo + hi) * 0.5;
		bvec3 below = lessThan(agxCurve(mid), target);
		lo = mix(lo, mid, below);
		hi = mix(mid, hi, below);
	}
	vec3 log2x = mix(vec3(AGX_MIN_EV), vec3(AGX_MAX_EV), (lo + hi) * 0.5);
	return max(inverse(AGX_IN) * exp2(log2x), vec3(0.0));
}

// Adds the log luminance of every 8th pixel each way to the frame's meter. Only terrain counts, traced or past
// the RT distance (lit alike, vanillaRadiance); not the sky.
// (Summing a subgroup's pixels with subgroupAdd after the ray queries hung the GPU within a minute.)
void meter(Frame frame, ivec2 p, vec3 radiance, vec3 albedo, bool traced) {
	if (!traced || any(notEqual(p & 7, ivec2(0)))) return;
	Meter m = Meter(frame.meter);
	atomicAdd(m.logSum, int(round(clamp(log2(max(luminance(radiance), 1e-4)), -16.0, 16.0) * 16.0)));
	atomicAdd(m.count, 1u);
	vec3 light = radiance / max(albedo, vec3(0.05));
	vec2 tint = clamp(light.rb / max(luminance(light), 1e-4), 0.0, 4.0);
	atomicAdd(m.red, uint(tint.x * 256.0));
	atomicAdd(m.blue, uint(tint.y * 256.0));
}

// Vanilla's picture at a fractional pixel position, bilinear: vanilla draws unjittered, so sampling it where
// this frame's rays went keeps it consistent with the jitter RR is told about (else the sun's edges shimmer).
// Where Helio draws the sky (replaceSky), taps on vanilla's sky (depth 0) take skySrgb instead, so silhouettes
// blend into Helio's sky, not vanilla's; skyShare: their weight.
vec3 vanillaAt(vec2 pixel, ivec2 size, bool replaceSky, vec3 skySrgb, out float skyShare) {
	vec2 f = pixel - 0.5;
	ivec2 i = ivec2(floor(f)), hi = size - 1;
	vec2 t = f - vec2(i);
	vec3 c = vec3(0.0);
	skyShare = 0.0;
	for (int k = 0; k < 4; k++) {
		ivec2 o = ivec2(k & 1, k >> 1), at = clamp(i + o, ivec2(0), hi);
		float w = (o.x == 1 ? t.x : 1.0 - t.x) * (o.y == 1 ? t.y : 1.0 - t.y);
		bool sky = replaceSky && texelFetch(depthTex, at, 0).r == 0.0;
		c += w * (sky ? skySrgb : imageLoad(colorImg, at).rgb);
		skyShare += sky ? w : 0.0;
	}
	return c;
}

// DLSS's inputs, at render size (the dispatch's). Where the tracer leaves vanilla's picture (sky, past the RT distance) RR gets that picture as
// radiance, with vanilla's depth, so RR anti-aliases and stabilises the whole frame and its edges.
// Vanilla's terrain fades into Helio's sky over the last EDGE_FADE of the render distance (vanilla's own distance
// fog, towards its brighter fog colour, is off while Helio draws the sky: FogRendererMixin).
const float EDGE_FADE = 0.2;
float fadeEnd; // Frame.fadeEnd
// Under DLSS vanilla's terrain is drawn with this frame's jitter (Frame.vanillaJittered): a window pixel's centre
// shows what lies vanillaShift (NDC) from it, along the jittered ray, so RR anti-aliases it over frames. Its
// picture is then read at pixel centres (vanillaTap 0); unjittered, at the ray's own offset (vanillaTap = jitter).
vec2 vanillaShift = vec2(0.0), vanillaTap;

float edgeFade(ivec2 windowPixel, vec2 ndc) {
	float depth = texelFetch(depthTex, windowPixel, 0).r;
	if (depth == 0.0) return 1.0;
	vec4 rel = pc.invViewProj * vec4(ndc + vanillaShift, depth, 1.0);
	return smoothstep(fadeEnd * (1.0 - EDGE_FADE), fadeEnd, length(rel.xz / rel.w));
}

// Helio draws the overworld's sky itself (Sky.java) where vanilla's depth is the sky's; underwater, vanilla's
// fog colour stays.
bool ownSky(ivec2 windowPixel) {
	return pc.skyColor.w != 0.0 && pc.fogColor.w == 0.0 && texelFetch(depthTex, windowPixel, 0).r == 0.0;
}

// The sky through a pixel (fractional, at render size), as the primary ray goes; capped for RR like vanilla's
// brightest pixel (the sun's core is far brighter).
vec3 skyThrough(vec2 pixel, vec2 size) {
	vec2 ndc = pixel / size * 2.0 - 1.0;
	vec4 near = pc.invViewProj * vec4(ndc, 1.0, 1.0), mid = pc.invViewProj * vec4(ndc, 0.5, 1.0);
	vec3 dir = normalize(mid.xyz / mid.w - near.xyz / near.w);
	vec3 eye = pc.cameraInScene.xyz + near.xyz / near.w;
	vec4 cloud = clouds(eye, dir, 1e9), haze = fog(eye, dir, 1e9);
	vec3 c = (skyRadiance(dir) * cloud.a + cloud.rgb) * haze.a + haze.rgb;
	float l = luminance(c);
	return l > SKY_SAMPLE ? c * (SKY_SAMPLE / l) : c;
}

// Vanilla's terrain past the RT distance (M8 step 10.0), shaded the way the traced picture is, so the two meet
// without a seam: it was vanilla's own flat lighting (no sun angle, no sky tint, no haze) right after traced
// terrain. Everything past the RT distance goes through here, LODs too later.
vec3 vanillaSky; // Frame.vanillaSky

// Position (relative to the camera) of vanilla's surface at a window pixel, from its depth.
vec3 vanillaPos(ivec2 w, ivec2 size) {
	vec2 ndc = (vec2(w) + 0.5) / vec2(size) * 2.0 - 1.0 + vanillaShift;
	vec4 rel = pc.invViewProj * vec4(ndc, texelFetch(depthTex, w, 0).r, 1.0);
	return rel.xyz / rel.w;
}

// Its normal at a tree crown's scale: from the depths FAR_NORMAL_SPAN pixels either way (the nearer one each way,
// so silhouettes don't bend it). Per pixel, leaves seen through their holes made it noise, and the light
// speckled; this way crowns are lit round, sun side bright, and flat ground still comes out flat.
const int FAR_NORMAL_SPAN = 3;
vec3 vanillaNormal(ivec2 w, ivec2 size, vec3 pos) {
	ivec2 hi = size - 1, sx = ivec2(FAR_NORMAL_SPAN, 0), sy = ivec2(0, FAR_NORMAL_SPAN);
	vec3 r = vanillaPos(min(w + sx, hi), size) - pos, l = pos - vanillaPos(max(w - sx, ivec2(0)), size);
	vec3 u = vanillaPos(min(w + sy, hi), size) - pos, d = pos - vanillaPos(max(w - sy, ivec2(0)), size);
	vec3 n = cross(dot(r, r) < dot(l, l) ? r : l, dot(u, u) < dot(d, d) ? u : d);
	// Next to the sky (depth 0: infinitely far) the steps are infinite: no normal, take up's. A NaN here
	// spread through Ray Reconstruction into black squares.
	if (any(isinf(n)) || any(isnan(n)) || dot(n, n) < 1e-12) return vec3(0.0, 1.0, 0.0);
	n = normalize(n);
	return dot(n, pos) > 0.0 ? -n : n; // towards the camera
}

// Share of the sky's light that arrives: traced terrain's is partly blocked (trees, slopes; the radiance cache
// knows), which left vanilla's bluer and brighter than it next to it.
const float FAR_SKY = 0.65;
// Light bounced off what's around (foliage, the ground), in its own colour, as a share of the sun's on the
// ground: in shade the sky's blue alone left far leaves blue-white where traced ones stay green.
const float FAR_BOUNCE = 0.25;

// Sun shadows for it, screen-space: steps towards the light (growing, from 1.5-2.5 out to about 25 blocks: other
// trees, cliffs) against vanilla's depth. Something nearer than the step, but within a few blocks of it (else
// it's in front, not in the way), shades it. Eight depth reads, only where vanilla's picture is used. Steps
// starting closer found a crown's own gaps pixel by pixel: a fixed speckle (frosted far leaves).
float vanillaShadow(vec3 pos, vec3 l, ivec2 size) {
	float t = 1.5 + rand();
	for (int i = 0; i < 8; i++, t *= 1.45) {
		vec3 q = pos + l * t;
		vec4 clip = pc.viewProj * vec4(q, 1.0);
		vec3 ndc = clip.xyz / clip.w;
		if (clip.w <= 0.0 || any(greaterThan(abs(ndc.xy), vec2(1.0)))) break;
		ivec2 at = clamp(ivec2(((ndc.xy - vanillaShift) * 0.5 + 0.5) * vec2(size)), ivec2(0), size - 1);
		if (texelFetch(depthTex, at, 0).r > ndc.z && length(q) - length(vanillaPos(at, size)) < 2.0 + 0.25 * t) return 0.0; // reversed Z
	}
	return 1.0;
}

// Vanilla's colour is the texture times its lightmap, face shade and ambient occlusion, in sRGB. Dividing out the
// lightmap (at full sky light: block-lit spots come out brighter, capped) leaves the texture with vanilla's shade
// and occlusion, kept as is (they're steady, and give faces their contrast): farAlbedo. It takes Helio's light:
// the sun or moon (shadowed by vanillaShadow), the sky's, what bounces off the surroundings, and the floor.
vec3 farAlbedo, farNormal; // RR's guides for vanilla's terrain
vec3 vanillaLit(vec3 srgb, vec3 pos, vec3 n) {
	vec3 albedo = srgbToLinear(min(srgb / max(vanillaSky, vec3(0.02)), vec3(1.0)));
	farAlbedo = albedo;
	farNormal = n;
	bool day = pc.sunDir.y > 0.0;
	vec3 l = day ? pc.sunDir.xyz : pc.moonDir.xyz, direct = vec3(0.0);
	vec3 sun = l.y > 0.0 ? (day ? sunRadiance(l.y) : moonRadiance(l.y)) : vec3(0.0);
	float nl = max(dot(n, l), 0.0);
	if (nl > 0.0 && l.y > 0.0) direct = nl * sun * cloudShadow(pc.cameraInScene.xyz + pos, l) * vanillaShadow(pos + n * 0.05, l, imageSize(colorImg));
	return albedo * (direct + skyIrradiance(n) * FAR_SKY + FAR_BOUNCE * albedo * sun * max(l.y, 0.0) + lightFloor * mix(nightFloor, 1.0, pc.sunDir.w));
}

// Vanilla's picture at a render pixel, as radiance. Where Helio draws the sky: its terrain shaded as above, with
// clouds and haze in front, fading into Helio's sky over the render distance's last EDGE_FADE. Elsewhere (Nether,
// End, underwater) vanilla's own picture. farSurface: how much of it is terrain (else sky), for RR's guides.
float farSurface;
vec3 vanillaRadiance(ivec2 p, ivec2 size, Frame frame) {
	farSurface = 0.0;
	ivec2 outSize = imageSize(colorImg);
	vec2 scale = vec2(outSize) / vec2(size), ndc = (vec2(p) + 0.5) / vec2(size) * 2.0 - 1.0;
	ivec2 under = clamp(ivec2((vec2(p) + 0.5) * scale), ivec2(0), outSize - 1);
	bool replaceSky = pc.skyColor.w != 0.0 && pc.fogColor.w == 0.0; // as ownSky()
	vec3 sky = replaceSky ? skyThrough(vec2(p) + 0.5 + pc.jitter, vec2(size)) : vec3(0.0);
	vec3 skySrgb = pow(tonemap(sky * frame.exposure), vec3(1.0 / 2.2));
	float skyShare;
	vec3 v = vanillaAt((vec2(p) + 0.5 + vanillaTap) * scale, outSize, replaceSky, skySrgb, skyShare);
	if (skyShare >= 0.999) return sky;
	if (!replaceSky) return untonemap(v) / frame.exposure;
	if ((off & OFF_BLEND) != 0u) return mix(untonemap(v) / frame.exposure, sky, edgeFade(under, ndc));
	vec3 pos = vanillaPos(under, outSize), dir = normalize(pos);
	// The bilinear taps can see terrain where the pixel under them is sky (depth 0, infinitely far): sky then.
	if (texelFetch(depthTex, under, 0).r == 0.0 || any(isinf(pos)) || any(isnan(pos))) return sky;
	// On the horizon's pixels taking the sky's share out can leave below zero, and pow() gave NaN there.
	vec3 c = vanillaLit(max((v - skyShare * skySrgb) / (1.0 - skyShare), vec3(0.0)), pos, vanillaNormal(under, outSize, pos));
	fogSkyLight = 1.0; // out in the open, as far terrain mostly is
	vec4 cloud = clouds(pc.cameraInScene.xyz, dir, length(pos)), haze = fog(pc.cameraInScene.xyz, dir, length(pos));
	c = (c * cloud.a + cloud.rgb) * haze.a + haze.rgb;
	float fade = edgeFade(under, ndc);
	if (any(isnan(c)) || any(isinf(c))) return sky;
	farSurface = (1.0 - fade) * (1.0 - skyShare);
	return mix(mix(c, sky, fade), sky, skyShare);
}

// A NaN or infinity in RR's inputs spreads through its history into black squares that grow as the view turns
// (seen once past the RT distance, M8 step 10.0): whatever made it, a pixel of nothing goes in instead.
bool bad(vec3 v) {
	return any(isnan(v)) || any(isinf(v));
}

void writeDenoiserInputs(ivec2 p, ivec2 size, vec4 current, Frame frame) {
	// Position relative to the camera, homogeneous: w = 0 for the sky (reversed-Z depth 0 is infinitely far).
	vec4 rel;
	if (current.a > 0.0) {
		rel = vec4(guidePos, 1.0);
		vec3 c = current.a >= 1.0 ? current.rgb : mix(vanillaRadiance(p, size, frame), current.rgb, current.a);
		if (bad(c)) c = vec3(0.0);
		float l = luminance(c);
		imageStore(rrColor, p, vec4(l > MAX_SAMPLE ? c * (MAX_SAMPLE / l) : c, 1.0));
		imageStore(rrDiffuse, p, vec4(guideAlbedo, 1.0));
		imageStore(rrSpecular, p, vec4(guideSpecular, 1.0));
		imageStore(rrNormals, p, vec4(guideNormal, guideRoughness));
		imageStore(rrHitDistance, p, vec4(guideHitDistance));
	} else {
		// Vanilla's picture is at the window's size: sample it where this render pixel's ray went.
		ivec2 outSize = imageSize(colorImg);
		vec2 scale = vec2(outSize) / vec2(size), ndc = (vec2(p) + 0.5) / vec2(size) * 2.0 - 1.0;
		ivec2 under = clamp(ivec2((vec2(p) + 0.5) * scale), ivec2(0), outSize - 1);
		rel = pc.invViewProj * vec4(ndc + vanillaShift, texelFetch(depthTex, under, 0).r, 1.0);
		vec3 c = vanillaRadiance(p, size, frame);
		if (bad(c)) c = vec3(0.0);
		imageStore(rrColor, p, vec4(c, 1.0));
		// Lit by Helio now, so it counts for the auto exposure like traced terrain.
		meter(frame, p, c, farAlbedo, farSurface > 0.5);
		// Vanilla's terrain as a rough diffuse surface, so RR denoises its light (the shadows' random steps) as it
		// does the traced picture's; the sky with RR's suggested defaults.
		bool surface = farSurface > 0.5 && !bad(farAlbedo) && !bad(farNormal);
		imageStore(rrDiffuse, p, vec4(surface ? farAlbedo : vec3(0.5), 1.0));
		imageStore(rrSpecular, p, vec4(0.0));
		imageStore(rrNormals, p, surface ? vec4(farNormal, 1.0) : vec4(0.0));
		imageStore(rrHitDistance, p, vec4(surface ? 0.0 : SKY_DISTANCE));
	}
	vec4 clip = pc.viewProj * rel;
	// Where it was last frame, relative to last frame's camera: entities by their own motion where known, the
	// rest of the world stood still while the camera moved.
	bool moving = current.a > 0.0 && hitEntity && !isnan(guideMotion.x);
	vec4 prev = frame.prevViewProj * (moving ? vec4(rel.xyz + guideMotion, 1.0) : vec4(rel.xyz + frame.cameraDelta.xyz * rel.w, rel.w));
	imageStore(rrDepth, p, vec4(clip.z / clip.w));
	imageStore(rrMotion, p, vec4((prev.xy / prev.w - clip.xy / clip.w) * 0.5 * vec2(size), 0.0, 0.0));
	imageStore(rrHitDepth, p, vec4(hitEntity ? hitDepth : hitTranslucent ? -hitDepth : 0.0));
}

void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(colorImg);
	if (any(greaterThanEqual(p, size))) return;

	uint debugView = uint(pc.cameraInScene.w);
	if (debugView != 0u) {
		vec2 ndc = (vec2(p) + 0.5) / vec2(size) * 2.0 - 1.0;
		vec4 near = pc.invViewProj * vec4(ndc, 1.0, 1.0), mid = pc.invViewProj * vec4(ndc, 0.5, 1.0);
		vec3 origin = near.xyz / near.w;
		vec3 dir = normalize(mid.xyz / mid.w - origin);
		rayQueryEXT rq;
		vec3 c = vec3(1.0, 0.0, 1.0); // magenta: the scene has nothing here
		TRACE_CAMERA(rq, pc.cameraInScene.xyz + origin, dir, 1024.0, 0xFFu)
		if (HIT(rq)) c = debugColour(rq, dir, debugView);
		imageStore(colorImg, p, vec4(c, 1.0));
		return;
	}

	rng = pcg(uint(p.x) + pcg(uint(p.y) + pcg(pc.stochastic != 0.0 ? pc.seed : 0u)));
	Frame frame = Frame(pc.frame);
	if (frame.denoise != 0u) size = imageSize(rrColor); // DLSS's render size
	vanillaShift = frame.vanillaJittered != 0u ? pc.jitter * 2.0 / vec2(size) : vec2(0.0);
	vanillaTap = frame.vanillaJittered != 0u ? vec2(0.0) : pc.jitter;
	if (any(greaterThanEqual(p, size))) return;
	bounces = int(frame.cameraDelta.w);
	lightFloor = frame.lightFloor;
	cloudTime = frame.cloudTime;
	cloudBottom = frame.cloudBottom;
	cloudCover = frame.cloudCover;
	fadeEnd = frame.fadeEnd;
	vanillaSky = frame.vanillaSky;
	anchorWorld = vec3(frame.anchor);
	caveFloor = frame.caveFloor;
	nightFloor = frame.nightFloor;
	wetness = frame.wetness;
	off = frame.off;
	fogSteps = frame.fogSteps;
	cloudSteps = frame.cloudSteps;
	lightCandidates = frame.lightCandidates;
	specularCutoff = frame.specularCutoff;
	cacheFeed = max(frame.cacheFeed, 1u);
	normalStrength = frame.normalStrength;
	hybrid = frame.hybrid != 0u;
	cacheOn = frame.cache != uvec2(0u);
	if (cacheOn) {
		cells = CacheCells(frame.cache);
		uint lo = frame.cache.x + CACHE_SIZE * 16u; // the sums array's address (64-bit add)
		sums = CacheSums(uvec2(lo, frame.cache.y + (lo < frame.cache.x ? 1u : 0u)));
		anchor = frame.anchor;
		// Whole 8x8 groups feed, not scattered pixels: the GPU runs 32 pixels in lockstep, and one feeding pixel
		// among them made all wait for its longer path.
		feeding = pcg(gl_WorkGroupID.x + pcg(gl_WorkGroupID.y + pcg(pc.seed ^ 0xA511E9B3u))) % cacheFeed == 0u;
	}
	vec4 current = radiance(vec2(p) + 0.5 + pc.jitter, vec2(size), uvec2(p));
	if (current.a > 0.0) { // clouds (flying above or through them) and haze between the camera and what it hit
		vec3 dir = normalize(guidePos);
		vec4 cloud = clouds(pc.cameraInScene.xyz, dir, length(guidePos)), haze = fog(pc.cameraInScene.xyz, dir, length(guidePos));
		current.rgb = (current.rgb * cloud.a + cloud.rgb) * haze.a + haze.rgb;
	}
	if (frame.denoise != 0u) {
		meter(frame, p, current.rgb, guideAlbedo, current.a > 0.0);
		writeDenoiserInputs(p, size, current, frame);
		return;
	}

	// Running average of premultiplied radiance + coverage: frame 0 restarts it. Coverage < 1 blends with
	// vanilla's picture (sky, terrain past the RT distance), which also anti-aliases those edges.
	current.rgb *= current.a;
	vec4 acc = pc.frameIndex == 0u ? current : mix(imageLoad(accumImg, p), current, 1.0 / float(pc.frameIndex + 1u));
	imageStore(accumImg, p, acc);
	vec4 vanilla = imageLoad(colorImg, p);
	bool sky = acc.a < 1.0 && pc.skyColor.w != 0.0 && pc.fogColor.w == 0.0; // Helio's sky, or vanilla's terrain shaded and fading into it
	if (sky) vanilla.rgb = pow(tonemap(vanillaRadiance(p, size, frame) * frame.exposure), vec3(1.0 / 2.2));
	vec3 shown = acc.a <= 0.0 ? vanilla.rgb : mix(vanilla.rgb, pow(tonemap(acc.rgb / acc.a * frame.exposure), vec3(1.0 / 2.2)), acc.a);
	// Vanilla draws entities over this next (for their depth); entity_composite.comp puts this colour back,
	// on the entity (depth matches) or behind traced water / glass (negative depth: anything behind it).
	imageStore(entityImg, p, vec4(shown, hitEntity ? hitDepth : hitTranslucent ? -hitDepth : 0.0));
	if (acc.a > 0.0 || sky) imageStore(colorImg, p, vec4(shown, vanilla.a));
}
