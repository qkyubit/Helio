#version 460

// Bloom's mip chain (Bloom.java; Jimenez, "Next Generation Post Processing in Call of Duty: Advanced Warfare").
// Down: src (DLSS's HDR output, then each smaller level) -> dst at half its size, 13-tap filter; the first pass
// weights its five 2x2 groups by 1 / (1 + luminance) (Karis) so single bright pixels don't flicker. Up: a 3x3
// tent of the smaller level src, added into dst. Linear sampling, clamped to the edge.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba16f) uniform image2D dst;

layout(push_constant) uniform Push { int mode; } pc; // 0 first down, 1 down, 2 up

const int FIRST_DOWN = 0, DOWN = 1, UP = 2;

vec3 at(vec2 uv) {
	return textureLod(src, uv, 0.0).rgb;
}

float karis(vec3 c) {
	return 1.0 / (1.0 + dot(c, vec3(0.2126, 0.7152, 0.0722)));
}

// The group's average, and its Karis weight added to w.
vec3 group(vec3 a, vec3 b, vec3 c, vec3 d, float share, inout vec3 sum, inout float w) {
	vec3 g = (a + b + c + d) * 0.25;
	float k = share * karis(g);
	sum += g * k;
	w += k;
	return g;
}

void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy), size = imageSize(dst);
	if (any(greaterThanEqual(p, size))) return;
	vec2 uv = (vec2(p) + 0.5) / vec2(size), t = 1.0 / vec2(textureSize(src, 0));
	vec3 c;
	if (pc.mode == UP) {
		c = (at(uv + t * vec2(-1, -1)) + at(uv + t * vec2(1, -1)) + at(uv + t * vec2(-1, 1)) + at(uv + t * vec2(1, 1))
			+ 2.0 * (at(uv + t * vec2(0, -1)) + at(uv + t * vec2(-1, 0)) + at(uv + t * vec2(1, 0)) + at(uv + t * vec2(0, 1)))
			+ 4.0 * at(uv)) / 16.0;
		c += imageLoad(dst, p).rgb;
	} else {
		vec3 a = at(uv + t * vec2(-2, -2)), b = at(uv + t * vec2(0, -2)), cc = at(uv + t * vec2(2, -2));
		vec3 d = at(uv + t * vec2(-2, 0)), e = at(uv), f = at(uv + t * vec2(2, 0));
		vec3 g = at(uv + t * vec2(-2, 2)), h = at(uv + t * vec2(0, 2)), i = at(uv + t * vec2(2, 2));
		vec3 j = at(uv + t * vec2(-1, -1)), k = at(uv + t * vec2(1, -1)), l = at(uv + t * vec2(-1, 1)), m = at(uv + t * vec2(1, 1));
		if (pc.mode == FIRST_DOWN) {
			vec3 sum = vec3(0.0);
			float w = 0.0;
			group(j, k, l, m, 0.5, sum, w);
			group(a, b, d, e, 0.125, sum, w);
			group(b, cc, e, f, 0.125, sum, w);
			group(d, e, g, h, 0.125, sum, w);
			group(e, f, h, i, 0.125, sum, w);
			c = sum / w;
		} else {
			c = e * 0.125 + (a + cc + g + i) * 0.03125 + (b + d + f + h) * 0.0625 + (j + k + l + m) * 0.125;
		}
	}
	imageStore(dst, p, vec4(any(isnan(c)) ? vec3(0.0) : max(c, vec3(0.0)), 1.0));
}
